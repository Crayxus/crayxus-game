/* Global styles — Crayxus theme */
page {
  background: var(--bg, #0a0e1a);
  color: var(--text, #fff);
  font-family: -apple-system, 'Helvetica Neue', 'Segoe UI', sans-serif;
  --cyan: #00ffff;
  --gold: #ffd700;
  --magenta: #ff00ff;
  --neon: #00ffcc;
  --red: #ff3b30;
  --panel: rgba(20, 22, 28, 0.98);
  --bg: #0a0e1a;
  --text: #fff;
  --card-bg: #151a2e;
  --border: rgba(255,255,255,0.08);
}

/* 亮色主题 */
page.light {
  --bg: #f0f2f5;
  --text: #1a1a2e;
  --card-bg: #fff;
  --border: rgba(0,0,0,0.08);
  --panel: rgba(255,255,255,0.98);
  --neon: #58cc02;
}
