.landing-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 50%, #0a0e1a 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 32rpx 40rpx;
  box-sizing: border-box;
}

/* Logo */
.landing-logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}
.landing-brand {
  font-size: 56rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 8rpx;
}
.landing-slogan {
  font-size: 22rpx;
  color: rgba(255,255,255,.35);
  letter-spacing: 4rpx;
  margin-top: 10rpx;
}

/* 2×2 网格 */
.landing-cards-grid {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22rpx;
}

/* 卡片通用 */
.landing-card {
  padding: 36rpx 20rpx 28rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  min-height: 320rpx;
}
.landing-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.card-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  font-size: 16rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
  padding: 3rpx 10rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #ff0080, #7c4dff);
  box-shadow: 0 2rpx 10rpx rgba(255,0,128,.4);
}

/* 各产品配色 */
.card-guandan {
  background: linear-gradient(135deg, rgba(0,212,170,.14) 0%, rgba(0,212,170,.04) 100%);
  border: 1rpx solid rgba(0,212,170,.28);
}
.card-truck {
  background: linear-gradient(135deg, rgba(61,157,255,.14) 0%, rgba(61,157,255,.04) 100%);
  border: 1rpx solid rgba(61,157,255,.28);
}
.card-racing {
  background: linear-gradient(135deg, rgba(255,0,128,.14) 0%, rgba(124,77,255,.08) 50%, rgba(0,212,255,.05) 100%);
  border: 1rpx solid rgba(255,0,128,.32);
}
.card-boost {
  background: linear-gradient(135deg, rgba(0,212,170,.14) 0%, rgba(124,77,255,.08) 50%, rgba(255,215,0,.05) 100%);
  border: 1rpx solid rgba(0,212,170,.32);
}

/* 图标 */
.card-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}
.guandan-icon { background: linear-gradient(135deg, rgba(0,212,170,.24), rgba(0,212,170,.08)); }
.truck-icon   { background: linear-gradient(135deg, rgba(61,157,255,.24), rgba(61,157,255,.08)); }
.racing-icon  { background: linear-gradient(135deg, rgba(255,0,128,.26), rgba(124,77,255,.1)); }
.boost-icon   { background: linear-gradient(135deg, rgba(0,212,170,.26), rgba(124,77,255,.1)); }
.card-icon { font-size: 52rpx; }

/* 文字 */
.card-title {
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  text-align: center;
  line-height: 1.3;
}
.card-desc {
  font-size: 18rpx;
  color: rgba(255,255,255,.42);
  letter-spacing: 0.5rpx;
  text-align: center;
  line-height: 1.5;
  margin: 2rpx 0 4rpx;
}

/* 箭头文字 */
.card-arrow-txt {
  margin-top: auto;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: 700;
}
.card-guandan .card-arrow-txt { color: #00d4aa; background: rgba(0,212,170,.1); border: 1rpx solid rgba(0,212,170,.3); }
.card-truck .card-arrow-txt   { color: #3d9dff; background: rgba(61,157,255,.1); border: 1rpx solid rgba(61,157,255,.3); }
.card-racing .card-arrow-txt  { color: #ff0080; background: rgba(255,0,128,.1); border: 1rpx solid rgba(255,0,128,.35); }
.card-boost .card-arrow-txt   { color: #00d4aa; background: rgba(0,212,170,.1); border: 1rpx solid rgba(0,212,170,.3); }

/* 底部 */
.landing-footer {
  margin-top: 44rpx;
  text-align: center;
}
.footer-text {
  font-size: 22rpx;
  color: rgba(255,255,255,.2);
}

/* ============ 投资者模式 · 单产品专属视图 ============ */
.investor-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 20rpx;
}
.investor-card {
  width: 100%;
  padding: 56rpx 36rpx 48rpx;
  border-radius: 32rpx;
  background:
    radial-gradient(circle at 20% 0%, rgba(0,212,170,.22), transparent 60%),
    radial-gradient(circle at 100% 100%, rgba(124,77,255,.2), transparent 60%),
    linear-gradient(135deg, rgba(10,14,26,.9), rgba(13,18,32,.95));
  border: 1rpx solid rgba(0,212,170,.25);
  box-shadow: 0 12rpx 48rpx rgba(0,212,170,.15);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.investor-card:active {
  transform: scale(0.98);
}
.inv-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 18rpx;
  background: linear-gradient(90deg, #00d4aa, #7c4dff);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  border-radius: 999rpx;
}
.inv-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, rgba(0,212,170,.3), rgba(124,77,255,.3));
  border: 1rpx solid rgba(0,212,170,.4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,212,170,.3);
}
.inv-icon {
  font-size: 88rpx;
  line-height: 1;
}
.inv-title {
  font-size: 44rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
  text-align: center;
}
.inv-tagline {
  font-size: 24rpx;
  color: rgba(0,212,170,.9);
  margin-top: 10rpx;
  letter-spacing: 1rpx;
  text-align: center;
}

.inv-features {
  display: flex;
  gap: 16rpx;
  margin: 36rpx 0 32rpx;
  width: 100%;
  justify-content: center;
}
.inv-feat {
  flex: 1;
  padding: 20rpx 12rpx;
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.if-ic {
  font-size: 36rpx;
  line-height: 1;
}
.if-tx {
  font-size: 22rpx;
  color: rgba(255,255,255,.8);
  font-weight: 600;
}

.inv-enter {
  width: 100%;
  padding: 26rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #00d4aa, #7c4dff);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0,212,170,.35);
}

.inv-hint {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,.35);
  letter-spacing: 2rpx;
  text-align: center;
}
