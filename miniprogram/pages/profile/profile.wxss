/* ===== Crayxus Player ID Card ===== */

.page-bg {
  min-height: 100vh;
  background: #000;
  position: relative;
  overflow: hidden;
  padding: 0 24rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

/* Spacer to push card down from status bar */
.page-spacer {
  height: 120rpx;
}

/* ===== Particles ===== */
.particles {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 0;
}
.particle {
  position: absolute;
  width: 4rpx; height: 4rpx;
  border-radius: 50%;
  opacity: 0;
  background: var(--cyan, #00ffff);
}
.p1 { left: 10%; animation: pFloat 8s 0s linear infinite; }
.p2 { left: 25%; animation: pFloat 10s 1s linear infinite; background: #ffd700; }
.p3 { left: 45%; animation: pFloat 7s 2s linear infinite; }
.p4 { left: 65%; animation: pFloat 9s 0.5s linear infinite; background: #ff00ff; }
.p5 { left: 80%; animation: pFloat 11s 3s linear infinite; }
.p6 { left: 90%; animation: pFloat 8s 1.5s linear infinite; background: #ffd700; }

@keyframes pFloat {
  0% { opacity: 0; bottom: -5%; transform: scale(0.5); }
  10% { opacity: 0.8; }
  90% { opacity: 0.6; }
  100% { opacity: 0; bottom: 105%; transform: scale(1.2); }
}

/* ===== Top Bar ===== */
.top-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  padding-bottom: 12rpx;
  z-index: 100;
}
.top-version {
  font-size: 22rpx;
  color: rgba(255,255,255,0.25);
  letter-spacing: 4rpx;
  font-weight: 700;
}
.top-scan {
  width: 60rpx; height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0,255,255,0.2);
  border-radius: 12rpx;
  background: rgba(0,255,255,0.05);
}
.scan-icon {
  font-size: 32rpx;
  color: rgba(0,255,255,0.6);
}

/* ===== Holo Card ===== */
.holo-card {
  position: relative;
  z-index: 10;
  margin: 20rpx auto 0;
  width: 100%;
  max-width: 680rpx;
  background: linear-gradient(165deg, rgba(20,22,30,0.98) 0%, rgba(10,10,18,0.98) 100%);
  border: 1rpx solid rgba(0,255,255,0.12);
  border-radius: 32rpx;
  padding: 40rpx 32rpx 32rpx;
  backdrop-filter: blur(20px);
  overflow: hidden;
}
.holo-card::before {
  content: '';
  position: absolute;
  top: -1rpx; left: -1rpx; right: -1rpx; bottom: -1rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, rgba(0,255,255,0.15), rgba(255,215,0,0.1), rgba(255,0,255,0.15));
  z-index: -1;
  opacity: 0.5;
}
.card-glow {
  position: absolute;
  top: -40rpx; left: 50%;
  transform: translateX(-50%);
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(0,255,255,0.06) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

/* Card enter animation */
.card-enter {
  animation: cardSlideUp 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
@keyframes cardSlideUp {
  0% { opacity: 0; transform: translateY(80rpx) scale(0.95); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ===== Avatar Section ===== */
.avatar-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
  position: relative;
  z-index: 1;
}
.avatar-ring {
  position: relative;
  width: 120rpx; height: 120rpx;
  flex-shrink: 0;
}
.avatar-glow {
  position: absolute;
  top: -20rpx; left: -20rpx;
  width: 160rpx; height: 160rpx;
  border-radius: 50%;
  pointer-events: none;
}
.avatar-img {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  background: #1a1a2e;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 3rpx solid #444;
  position: relative;
  z-index: 2;
}
.avatar-ring-border {
  position: absolute;
  top: -4rpx; left: -4rpx;
  width: 128rpx; height: 128rpx;
  border-radius: 50%;
  border: 2rpx dashed;
  opacity: 0.5;
  animation: ringRotate 12s linear infinite;
  z-index: 1;
}
@keyframes ringRotate {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.player-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.player-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
}
.player-rank-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rank-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  border: 1rpx solid;
  letter-spacing: 2rpx;
}
.rank-stars {
  display: flex;
  gap: 4rpx;
}
.star {
  font-size: 24rpx;
}
.star-off {
  color: #333;
}
.player-title {
  font-size: 22rpx;
  color: rgba(255,255,255,0.3);
  letter-spacing: 2rpx;
}

/* ===== ELO Display ===== */
.elo-display {
  text-align: center;
  margin: 24rpx 0 32rpx;
  position: relative;
  z-index: 1;
}
.elo-label {
  display: block;
  font-size: 18rpx;
  color: rgba(255,255,255,0.25);
  letter-spacing: 8rpx;
  margin-bottom: 8rpx;
}
.elo-value {
  display: block;
  font-size: 80rpx;
  font-weight: 900;
  color: #00ffff;
  text-shadow: 0 0 30rpx #00ffff, 0 0 60rpx rgba(0,255,255,0.4);
  line-height: 1;
  letter-spacing: 4rpx;
}
.elo-peak {
  display: block;
  font-size: 20rpx;
  color: rgba(255,215,0,0.4);
  margin-top: 8rpx;
  letter-spacing: 4rpx;
}

/* ===== Tab Bar ===== */
.tab-bar {
  display: flex;
  gap: 8rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 1;
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.03);
  transition: all 0.25s;
}
.tab-icon {
  font-size: 24rpx;
}
.tab-text {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.4);
  letter-spacing: 2rpx;
}
.tab-active {
  border-color: rgba(0,255,255,0.3);
  background: rgba(0,255,255,0.06);
}
.tab-active .tab-text {
  color: #00ffff;
}
.tab-casual.tab-active {
  border-color: rgba(0,255,255,0.3);
  background: rgba(0,255,255,0.06);
}
.tab-casual.tab-active .tab-text {
  color: #00ffff;
}
.tab-training.tab-active {
  border-color: rgba(255,215,0,0.3);
  background: rgba(255,215,0,0.06);
}
.tab-training.tab-active .tab-text {
  color: #ffd700;
}
.tab-arena.tab-active {
  border-color: rgba(255,0,255,0.3);
  background: rgba(255,0,255,0.06);
}
.tab-arena.tab-active .tab-text {
  color: #ff00ff;
}

/* ===== Stats Panel ===== */
.stats-panel {
  position: relative;
  z-index: 1;
  min-height: 240rpx;
}
.stats-content {
  animation: fadeIn 0.3s ease-out;
}
@keyframes fadeIn {
  0% { opacity: 0; transform: translateY(10rpx); }
  100% { opacity: 1; transform: translateY(0); }
}
.stat-row {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx;
  background: rgba(255,255,255,0.03);
  border: 1rpx solid rgba(255,255,255,0.06);
  border-radius: 16rpx;
}
.stat-val {
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.2;
}
.stat-label {
  font-size: 18rpx;
  color: rgba(255,255,255,0.3);
  margin-top: 6rpx;
  letter-spacing: 1rpx;
}

/* Stat value colors */
.cyan { color: #00ffff; text-shadow: 0 0 10rpx rgba(0,255,255,0.3); }
.cyan-big { color: #00ffff; text-shadow: 0 0 20rpx rgba(0,255,255,0.5); font-size: 44rpx; }
.gold { color: #ffd700; text-shadow: 0 0 10rpx rgba(255,215,0,0.3); }
.neon { color: #00ffcc; text-shadow: 0 0 10rpx rgba(0,255,204,0.3); }
.magenta { color: #ff00ff; text-shadow: 0 0 10rpx rgba(255,0,255,0.3); }
.red { color: #ff3b30; text-shadow: 0 0 10rpx rgba(255,59,48,0.3); }
.white { color: rgba(255,255,255,0.8); }
.fire { color: #ff6b00; text-shadow: 0 0 15rpx rgba(255,107,0,0.5); }

/* ===== Bottom Actions ===== */
.bottom-actions {
  position: relative;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 0 16rpx;
}
.scan-btn {
  flex: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  border-radius: 50rpx;
  background: linear-gradient(90deg, #00ffcc, #00b8ff);
  box-shadow: 0 0 30rpx rgba(0,255,204,0.3);
}
.scan-btn-icon {
  font-size: 32rpx;
}
.scan-btn-text {
  font-size: 26rpx;
  font-weight: 900;
  color: #000;
  letter-spacing: 4rpx;
}
.share-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  border-radius: 50rpx;
  border: 1rpx solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.05);
}
.share-btn-text {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(255,255,255,0.5);
  letter-spacing: 4rpx;
}

/* ===== Watermark ===== */
.watermark {
  text-align: center;
  margin-top: 40rpx;
  position: relative;
  z-index: 1;
}
.wm-text {
  font-size: 24rpx;
  font-weight: 900;
  color: rgba(255,255,255,0.06);
  letter-spacing: 16rpx;
}

/* ===== Avatar Button (chooseAvatar) ===== */
.avatar-btn {
  width: 120rpx; height: 120rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: 1;
  position: relative;
  z-index: 2;
}
.avatar-btn::after {
  display: none; /* remove default button border */
}
.avatar-placeholder {
  background: rgba(0,255,255,0.08) !important;
  border: 2rpx dashed rgba(0,255,255,0.3) !important;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-plus {
  font-size: 48rpx;
  color: rgba(0,255,255,0.5);
  font-weight: 300;
}

/* Avatar image (WeChat photo) */
image.avatar-img {
  width: 120rpx; height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #444;
  position: relative;
  z-index: 2;
}

/* ===== Nickname Input ===== */
.nickname-input {
  height: 48rpx;
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 2rpx;
  background: transparent;
  border-bottom: 1rpx solid rgba(0,255,255,0.2);
  padding: 0;
  width: 100%;
}
.nickname-input::placeholder {
  color: rgba(0,255,255,0.3);
  font-size: 26rpx;
  font-weight: 400;
}
