page { background: #0a0e1a; }

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 100%);
}

.header {
  padding: 16rpx 0 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  background: rgba(255,255,255,.03);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 20rpx;
}
.avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,.15);
}
.avatar-btn {
  width: 100rpx; height: 100rpx;
  padding: 0; margin: 0;
  border: none; background: transparent;
}
.avatar-btn::after { display: none; }
.avatar-empty {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: rgba(0,212,170,.06);
  border: 2rpx dashed rgba(0,212,170,.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: rgba(0,212,170,.4);
}
.user-info { flex: 1; }
.name {
  font-size: 32rpx; font-weight: 800; color: #fff;
  display: block; margin-bottom: 8rpx;
}
.name-input {
  font-size: 32rpx; font-weight: 800; color: #fff;
  height: 48rpx; background: transparent;
  border-bottom: 1rpx solid rgba(0,212,170,.15);
  padding: 0; margin-bottom: 8rpx;
}
.name-input::placeholder { color: rgba(255,255,255,.25); font-size: 24rpx; font-weight: 400; }
.danli-badge {
  display: flex; align-items: center; gap: 12rpx;
}
.danli-badge-score {
  font-size: 24rpx; font-weight: 700; color: #ffd700;
}
.danli-badge-rank {
  font-size: 20rpx; color: #00d4aa;
  padding: 2rpx 12rpx;
  background: rgba(0,212,170,.1);
  border-radius: 10rpx;
}
.danli-badge-empty {
  font-size: 22rpx; color: rgba(255,255,255,.3);
}

/* Section */
.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,.02);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 16rpx;
}
.section-title {
  font-size: 28rpx; font-weight: 700; color: #fff;
  margin-bottom: 20rpx;
}

/* 维度 */
.dim-list { display: flex; flex-direction: column; gap: 16rpx; }
.dim-row { display: flex; align-items: center; gap: 12rpx; }
.dim-icon { font-size: 28rpx; width: 40rpx; text-align: center; }
.dim-name { font-size: 24rpx; color: rgba(255,255,255,.6); width: 80rpx; }
.dim-bar { flex: 1; height: 12rpx; background: rgba(255,255,255,.06); border-radius: 6rpx; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 6rpx; }
.dim-val { font-size: 26rpx; font-weight: 700; width: 80rpx; text-align: right; }

/* 统计 */
.stat-list { display: flex; flex-direction: column; }
.stat-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
}
.stat-row:last-child { border: none; }
.stat-label { font-size: 26rpx; color: rgba(255,255,255,.5); }
.stat-val { font-size: 30rpx; font-weight: 700; color: #fff; }
.stat-val.accent { color: #00d4aa; }
.stat-val.gold { color: #ffd700; }

/* 操作 */
.action-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
}
.action-row:last-child { border: none; }
.action-icon { font-size: 32rpx; }
.action-label { flex: 1; font-size: 28rpx; color: rgba(255,255,255,.7); }
.action-arrow { font-size: 32rpx; color: rgba(255,255,255,.2); }

/* 蛋力值卡片（能力评分） */
.danli-card-profile {
  background: linear-gradient(135deg, rgba(0,212,170,0.08), rgba(124,77,255,0.06));
  border: 1rpx solid rgba(0,212,170,0.2);
  border-radius: 20rpx; padding: 24rpx; text-align: center;
}
.danli-row { display: flex; align-items: baseline; justify-content: center; gap: 4rpx; }
.danli-score-big { font-size: 72rpx; font-weight: 900; color: #00d4aa; }
.danli-score-max { font-size: 28rpx; color: rgba(255,255,255,.25); }
.danli-rank-text { display: block; font-size: 28rpx; font-weight: 700; color: #ffd700; margin: 4rpx 0; }
.danli-hint { display: block; font-size: 18rpx; color: rgba(255,255,255,.3); margin-top: 8rpx; }

/* 蛋力 Token 卡片（虚拟货币） */
.token-card {
  background: linear-gradient(135deg, rgba(255,200,0,0.12), rgba(255,200,0,0.04));
  border: 1rpx solid rgba(255,200,0,0.25);
  border-radius: 20rpx; padding: 24rpx;
}
.token-row { display: flex; align-items: center; gap: 12rpx; }
.token-balance { font-size: 48rpx; font-weight: 900; color: #ffc800; }
.token-unit { font-size: 24rpx; color: #ffc800; }
.token-desc { display: block; font-size: 20rpx; color: #8899aa; margin-top: 6rpx; line-height: 1.6; }

/* 联系我们 */
.contact-footer {
  text-align: center; padding: 40rpx 24rpx; margin-top: 20rpx;
  border-top: 1rpx solid #1e3148;
}
.contact-title { font-size: 24rpx; color: #8899aa; display: block; margin-bottom: 8rpx; }
.contact-email { font-size: 28rpx; color: #58cc02; display: block; margin-bottom: 12rpx; }
.contact-copy { font-size: 20rpx; color: #556; display: block; }

/* 亮色主题 */
.page.light { background: linear-gradient(180deg, #f0f2f5, #e8ecf0) !important; }
.page.light .header-title { color: #1a1a2e !important; }
.page.light .user-card { background: #fff !important; border-color: rgba(0,0,0,0.08) !important; }
.page.light .section { background: #fff !important; }
.page.light .section-title { color: #1a1a2e !important; }
.page.light .action-label { color: #1a1a2e !important; }
.page.light .token-card { background: rgba(255,200,0,0.08) !important; }
.page.light .name { color: #1a1a2e !important; }
