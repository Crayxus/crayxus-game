/* ===== Crayxus Full-Screen Profile ===== */
page { background: #000; }

.page {
  min-height: 100vh;
  background: linear-gradient(180deg, #0a0a14 0%, #000 40%, #050510 100%);
  position: relative;
  overflow-x: hidden;
  padding: 0 28rpx;
  box-sizing: border-box;
}

/* ===== Particles ===== */
.particles { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; }
.particle { position: absolute; width: 4rpx; height: 4rpx; border-radius: 50%; opacity: 0; background: #00ffff; }
.p1 { left: 8%;  animation: pF 8s 0s linear infinite; }
.p2 { left: 20%; animation: pF 10s 1s linear infinite; background: #ffd700; }
.p3 { left: 35%; animation: pF 7s 2s linear infinite; }
.p4 { left: 52%; animation: pF 9s .5s linear infinite; background: #ff00ff; }
.p5 { left: 68%; animation: pF 11s 3s linear infinite; }
.p6 { left: 82%; animation: pF 8s 1.5s linear infinite; background: #ffd700; }
.p7 { left: 92%; animation: pF 9s 2.5s linear infinite; }
.p8 { left: 15%; animation: pF 12s 4s linear infinite; background: #ff00ff; }
@keyframes pF {
  0% { opacity: 0; bottom: -5%; transform: scale(.5); }
  10% { opacity: .6; }
  90% { opacity: .4; }
  100% { opacity: 0; bottom: 105%; transform: scale(1); }
}

/* ===== Top Row ===== */
.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  position: relative;
  z-index: 10;
}
.top-ver { font-size: 20rpx; color: rgba(255,255,255,.2); letter-spacing: 3rpx; font-weight: 700; }
.top-scan-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  background: rgba(255,255,255,.04);
}
.top-scan-icon { font-size: 26rpx; color: rgba(255,255,255,.4); }

/* ===== User Info Bar ===== */
.user-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin: 8rpx 0 16rpx;
  background: rgba(255,255,255,.03);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 16rpx;
  position: relative;
  z-index: 10;
}
.user-bar-left { display: flex; align-items: center; gap: 16rpx; flex: 1; min-width: 0; }
.ub-avatar {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255,255,255,.15);
  flex-shrink: 0;
}
.ub-avatar-btn {
  width: 64rpx; height: 64rpx; padding: 0; margin: 0;
  border: none; background: transparent; line-height: 1; flex-shrink: 0;
}
.ub-avatar-btn::after { display: none; }
.ub-avatar-empty {
  background: rgba(0,255,255,.06);
  border: 2rpx dashed rgba(0,255,255,.2) !important;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: rgba(0,255,255,.4);
}
.ub-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.ub-name { font-size: 26rpx; font-weight: 800; color: #fff; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ub-name-input {
  font-size: 26rpx; font-weight: 800; color: #fff; height: 40rpx;
  background: transparent; border-bottom: 1rpx solid rgba(0,255,255,.15); padding: 0; width: 100%;
}
.ub-name-input::placeholder { color: rgba(0,255,255,.25); font-size: 22rpx; font-weight: 400; }
.ub-title { font-size: 18rpx; color: rgba(255,255,255,.25); letter-spacing: 1rpx; }
.ub-rank-pill {
  display: flex; flex-direction: column; align-items: center; gap: 2rpx;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid;
  flex-shrink: 0;
}
.ub-rank-text { font-size: 16rpx; font-weight: 800; letter-spacing: 1rpx; }
.ub-stars { display: flex; gap: 2rpx; font-size: 16rpx; }

/* ===== Hero Card Section ===== */
.hero-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8rpx 0 20rpx;
  position: relative;
  z-index: 10;
}
.hero-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-glow {
  position: absolute;
  width: 400rpx; height: 400rpx;
  background: radial-gradient(circle, rgba(255,215,0,.08) 0%, rgba(255,0,255,.04) 40%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}
.hero-frame {
  width: 180rpx; height: 180rpx;
  border: 3rpx solid;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  box-shadow: 0 0 40rpx rgba(255,215,0,.15), 0 0 80rpx rgba(255,215,0,.06), inset 0 0 40rpx rgba(255,215,0,.05);
  background: linear-gradient(165deg, #1a1a2e 0%, #0d0d1a 100%);
}
.hero-avatar {
  width: 100%; height: 100%;
  display: block;
}
.hero-avatar-btn {
  width: 100%; height: 100%;
  padding: 0; margin: 0;
  border: none; background: transparent;
  position: absolute; top: 0; left: 0;
}
.hero-avatar-btn::after { display: none; }
.hero-avatar-empty {
  width: 100%; height: 100%;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8rpx;
  background: linear-gradient(165deg, rgba(0,255,255,.04) 0%, rgba(255,0,255,.02) 100%);
}
.hero-plus { font-size: 64rpx; color: rgba(255,255,255,.15); font-weight: 200; }
.hero-plus-hint { font-size: 16rpx; color: rgba(255,255,255,.15); letter-spacing: 2rpx; }

.hero-elo-side {
  position: absolute;
  right: -100rpx; top: 50%;
  transform: translateY(-50%);
  display: flex; flex-direction: column; align-items: center;
}
.hero-elo-val { font-size: 44rpx; font-weight: 900; text-shadow: 0 0 16rpx currentColor; }
.hero-elo-label { font-size: 16rpx; color: rgba(255,255,255,.2); letter-spacing: 3rpx; margin-top: 2rpx; }

.hero-elo-main {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
}
.hero-elo-number {
  font-size: 88rpx;
  font-weight: 900;
  color: #fff;
  text-shadow: 0 0 20rpx rgba(255,255,255,.2);
  letter-spacing: 4rpx;
  line-height: 1;
}
.hero-elo-dot { font-size: 20rpx; }

/* ===== Tab Bar ===== */
.tab-bar {
  display: flex;
  gap: 8rpx;
  margin: 8rpx 0 20rpx;
  position: relative;
  z-index: 10;
}
.tab {
  flex: 1;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: rgba(255,255,255,.03);
  border: 1rpx solid rgba(255,255,255,.06);
}
.tab-icon { font-size: 22rpx; }
.tab-txt { font-size: 18rpx; font-weight: 700; color: rgba(255,255,255,.3); letter-spacing: 1rpx; }
.tab-on .tab-txt { color: #fff; }
.tab-c { background: rgba(0,255,255,.08); border-color: rgba(0,255,255,.2); }
.tab-t { background: rgba(255,215,0,.08); border-color: rgba(255,215,0,.2); }
.tab-a { background: rgba(255,0,255,.08); border-color: rgba(255,0,255,.2); }

/* ===== Stats List ===== */
.stats-list {
  position: relative;
  z-index: 10;
  padding-bottom: 140rpx; /* space for bottom nav */
}
.sl-row {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
  animation: slFade .25s ease-out;
}
@keyframes slFade {
  0% { opacity: 0; transform: translateX(-10rpx); }
  100% { opacity: 1; transform: translateX(0); }
}
.sl-icon-wrap {
  width: 48rpx; height: 48rpx;
  border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.cyan-bg { background: rgba(0,255,255,.1); }
.gold-bg { background: rgba(255,215,0,.1); }
.neon-bg { background: rgba(0,255,204,.1); }
.fire-bg { background: rgba(255,107,0,.1); }
.mag-bg  { background: rgba(255,0,255,.1); }
.sl-icon { font-size: 24rpx; }
.sl-label { flex: 1; font-size: 24rpx; color: rgba(255,255,255,.55); }
.sl-val { font-size: 34rpx; font-weight: 900; text-align: right; }
.sl-sub { font-size: 20rpx; color: rgba(255,255,255,.2); font-weight: 400; }
.sl-slash { color: rgba(255,255,255,.15); font-weight: 400; margin: 0 4rpx; }

/* Stat colors */
.cyan { color: #00ffff; }
.gold { color: #ffd700; }
.neon { color: #00ffcc; }
.magenta { color: #ff00ff; }
.red { color: #ff3b30; }
.white { color: rgba(255,255,255,.7); }
.fire { color: #ff6b00; }

/* ===== Bottom Nav ===== */
.bottom-nav {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(10,10,20,.92);
  border-top: 1rpx solid rgba(255,255,255,.06);
  backdrop-filter: blur(20px);
  z-index: 100;
}
.nav-item {
  display: flex; flex-direction: column;
  align-items: center; gap: 4rpx;
  padding: 8rpx 32rpx;
  border-radius: 12rpx;
}
.nav-active {
  background: rgba(255,0,255,.1);
  border: 1rpx solid rgba(255,0,255,.2);
}
.nav-icon { font-size: 36rpx; }
.nav-label { font-size: 18rpx; color: rgba(255,255,255,.35); letter-spacing: 1rpx; }
.nav-active .nav-label { color: #ff00ff; }

/* ===== Setup Modal ===== */
.setup-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.85); z-index: 200;
  display: flex; align-items: center; justify-content: center;
  backdrop-filter: blur(10px);
}
.setup-modal {
  width: 580rpx; padding: 40rpx;
  background: #1a1a2e;
  border: 2rpx solid rgba(0,255,255,.3);
  border-radius: 24rpx;
  box-shadow: 0 0 40rpx rgba(0,255,255,.1);
}
.setup-title {
  display: block; text-align: center;
  font-size: 28rpx; font-weight: 900; color: #00ffff;
  letter-spacing: 3rpx; margin-bottom: 8rpx;
}
.setup-hint {
  display: block; text-align: center;
  font-size: 20rpx; color: rgba(255,255,255,.3); margin-bottom: 32rpx;
}
.setup-row {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.setup-label {
  font-size: 24rpx; color: rgba(255,255,255,.5); width: 140rpx; flex-shrink: 0;
}
.setup-avatar-btn {
  width: 80rpx; height: 80rpx; padding: 0; margin: 0;
  border: 2rpx dashed rgba(0,255,255,.3); border-radius: 50%;
  background: rgba(0,255,255,.05);
  display: flex; align-items: center; justify-content: center;
  overflow: hidden; line-height: 1;
}
.setup-avatar-btn::after { display: none; }
.setup-avatar-img { width: 100%; height: 100%; border-radius: 50%; }
.setup-avatar-plus { font-size: 40rpx; color: rgba(0,255,255,.4); }
.setup-nick-input {
  flex: 1; height: 64rpx; font-size: 24rpx; color: #fff;
  background: rgba(255,255,255,.05); border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 12rpx; padding: 0 16rpx;
}
.setup-nick-input::placeholder { color: rgba(255,255,255,.2); }
.setup-check { color: #00ffcc; font-size: 28rpx; flex-shrink: 0; }
.setup-note {
  display: block; text-align: center;
  font-size: 18rpx; color: rgba(255,255,255,.2); margin-top: 24rpx;
}

/* ===== Classic Theme ===== */
.classic { background: linear-gradient(180deg, #f5f0e8 0%, #ede6d6 40%, #f0ebe0 100%) !important; }
.classic .particles { display: none; }
.classic .top-ver { color: rgba(0,0,0,.25); }
.classic .top-scan-btn { border-color: rgba(0,0,0,.1); background: rgba(0,0,0,.04); }
.classic .top-scan-icon { color: rgba(0,0,0,.5); }
.classic .user-bar { background: rgba(255,255,255,.8); border-color: rgba(0,0,0,.08); box-shadow: 0 2rpx 12rpx rgba(0,0,0,.05); }
.classic .ub-avatar { border-color: rgba(0,0,0,.12); }
.classic .ub-avatar-empty { background: rgba(0,0,0,.04); border-color: rgba(0,0,0,.15) !important; color: rgba(0,0,0,.3); }
.classic .ub-name { color: #333; }
.classic .ub-name-input { color: #333; border-bottom-color: rgba(0,0,0,.12); }
.classic .ub-name-input::placeholder { color: rgba(0,0,0,.25); }
.classic .ub-title { color: rgba(0,0,0,.4); }
.classic .hero-glow { display: none; }
.classic .hero-frame { background: linear-gradient(165deg, #fff 0%, #f5f0e8 100%); box-shadow: 0 4rpx 20rpx rgba(0,0,0,.1); border-color: #c8a96e !important; }
.classic .hero-avatar-empty { background: linear-gradient(165deg, rgba(0,0,0,.02) 0%, rgba(0,0,0,.04) 100%); }
.classic .hero-plus { color: rgba(0,0,0,.2); }
.classic .hero-plus-hint { color: rgba(0,0,0,.2); }
.classic .tab-bar .tab { background: rgba(255,255,255,.6); border-color: rgba(0,0,0,.08); }
.classic .tab-txt { color: rgba(0,0,0,.35); }
.classic .tab-on .tab-txt { color: #333; }
.classic .tab-c { background: rgba(70,130,180,.1); border-color: rgba(70,130,180,.3); }
.classic .tab-t { background: rgba(180,140,60,.1); border-color: rgba(180,140,60,.3); }
.classic .tab-a { background: rgba(160,80,80,.1); border-color: rgba(160,80,80,.3); }
.classic .sl-row { border-bottom-color: rgba(0,0,0,.06); }
.classic .sl-label { color: rgba(0,0,0,.55); }
.classic .sl-val { text-shadow: none; }
.classic .cyan { color: #2e8b8b; }
.classic .gold { color: #b8860b; }
.classic .neon { color: #2e8b57; }
.classic .magenta { color: #993399; }
.classic .red { color: #cc3333; }
.classic .white { color: rgba(0,0,0,.5); }
.classic .fire { color: #cc6600; }
.classic .sl-sub { color: rgba(0,0,0,.3); }
.classic .sl-slash { color: rgba(0,0,0,.15); }
.classic .sl-icon-wrap { opacity: 0.8; }
.classic .cyan-bg { background: rgba(46,139,139,.12); }
.classic .gold-bg { background: rgba(184,134,11,.12); }
.classic .neon-bg { background: rgba(46,139,87,.12); }
.classic .fire-bg { background: rgba(204,102,0,.12); }
.classic .mag-bg { background: rgba(153,51,153,.12); }
.classic .bottom-nav { background: rgba(245,240,232,.95); border-top-color: rgba(0,0,0,.08); }
.classic .nav-label { color: rgba(0,0,0,.35); }
.classic .nav-active { background: rgba(180,140,60,.1); border-color: rgba(180,140,60,.25); }
.classic .nav-active .nav-label { color: #996633; }
.classic .ub-rank-pill { box-shadow: 0 2rpx 8rpx rgba(0,0,0,.05); }
