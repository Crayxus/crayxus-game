<!-- 个人中心 -->
<view class="page {{isLight ? 'light' : ''}}">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- Header -->
  <view class="header">
    <text class="header-title">我的</text>
  </view>

  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-left">
      <button wx:if="{{!avatarUrl}}" class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="avatar avatar-empty">+</view>
      </button>
      <image wx:else class="avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="onTapAvatar"></image>
    </view>
    <view class="user-info">
      <input wx:if="{{!hasNickname}}" class="name-input" type="nickname" placeholder="点击设置昵称" bindchange="onNicknameChange" />
      <text wx:else class="name" bindtap="onTapNickname">{{nickname}}</text>
      <view class="danli-badge" wx:if="{{danli.score}}">
        <text class="danli-badge-score">蛋力值 {{danli.score}}</text>
        <text class="danli-badge-rank">{{danli.rank}}</text>
      </view>
      <text class="danli-badge-empty" wx:else>尚未测评蛋力值</text>
    </view>
  </view>

  <!-- 蛋力值（能力评分） -->
  <view class="section" wx:if="{{danli.score}}">
    <view class="section-title">蛋力值 · 能力评分</view>
    <view class="danli-card-profile">
      <view class="danli-row">
        <text class="danli-score-big">{{danli.score}}</text>
        <text class="danli-score-max">/1000</text>
      </view>
      <text class="danli-rank-text" wx:if="{{danli.rank}}">{{danli.rank}}</text>
      <text class="danli-hint">通过段位测评获得，代表你的掼蛋综合实力</text>
    </view>
  </view>

  <!-- 蛋力Token（虚拟货币） -->
  <view class="section">
    <view class="section-title">蛋力 Token · 虚拟货币</view>
    <view class="token-card">
      <view class="token-row">
        <text style="font-size:24px">🥚</text>
        <text class="token-balance">{{eggBalance || 100}}</text>
        <text class="token-unit">枚</text>
      </view>
      <text class="token-desc">完成课程+5 · 通过测评+20 · 每日登录+10</text>
      <text class="token-desc">可用于解锁课程、报名赛事、AI教练等</text>
    </view>
  </view>

  <!-- 六维雷达 -->
  <view class="section" wx:if="{{danli.score}}">
    <view class="section-title">六边形战士</view>
    <view class="dim-list">
      <view class="dim-row" wx:for="{{dims}}" wx:key="key">
        <text class="dim-icon">{{item.icon}}</text>
        <text class="dim-name">{{item.name}}</text>
        <view class="dim-bar">
          <view class="dim-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view>
        </view>
        <text class="dim-val" style="color:{{item.color}}">{{item.val}}</text>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="section">
    <view class="action-row" bindtap="onShareCard">
      <text class="action-icon">📤</text>
      <text class="action-label">分享给好友</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-row" bindtap="onScanLogin">
      <text class="action-icon">📱</text>
      <text class="action-label">扫码登录游戏</text>
      <text class="action-arrow">›</text>
    </view>
    <view class="action-row" bindtap="toggleTheme">
      <text class="action-icon">🌓</text>
      <text class="action-label">切换主题（黑/白）</text>
      <text class="action-arrow">›</text>
    </view>
  </view>

  <!-- 联系我们 -->
  <view class="contact-footer">
    <text class="contact-title">联系我们</text>
    <text class="contact-email" style="user-select:text">general@crayxus.com.au</text>
    <text class="contact-copy">© 2026 Crayxus · AI 掼蛋大师</text>
  </view>

  <view style="height:120rpx"></view>
</view>
