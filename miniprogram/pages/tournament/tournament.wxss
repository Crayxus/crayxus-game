page { background: #0a0e1a; }

.page {
  min-height: 100vh;
  padding: 0 20rpx;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 100%);
}

/* Nav */
.nav-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 0 20rpx;
}
.nav-back {
  font-size: 36rpx;
  color: rgba(255,255,255,.6);
  width: 60rpx;
  text-align: center;
}
.nav-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  text-align: center;
}
.nav-right { width: 60rpx; }

/* Loading & Empty */
.loading { text-align: center; padding-top: 200rpx; }
.loading-text { font-size: 28rpx; color: rgba(255,255,255,.3); }
.empty {
  display: flex; flex-direction: column; align-items: center;
  padding-top: 200rpx; gap: 16rpx;
}
.empty-icon { font-size: 100rpx; }
.empty-text { font-size: 32rpx; color: rgba(255,255,255,.5); font-weight: 600; }
.empty-sub { font-size: 24rpx; color: rgba(255,255,255,.25); }

/* Week Nav */
.week-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.week-arrow {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: rgba(255,255,255,.4);
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 10rpx;
}
.week-label-text {
  font-size: 28rpx; font-weight: 700; color: #fff;
  letter-spacing: 2rpx;
}

/* ===== Calendar Header Strip ===== */
.cal-header {
  display: flex;
  margin-bottom: 20rpx;
  background: rgba(255,255,255,.02);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 14rpx;
  padding: 12rpx 4rpx;
}
.cal-h-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}
.cal-h-wd { font-size: 18rpx; color: rgba(255,255,255,.3); font-weight: 600; }
.cal-h-d { font-size: 24rpx; color: rgba(255,255,255,.5); font-weight: 700; }
.cal-h-cell.today .cal-h-d {
  color: #000;
  background: #00d4aa;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.cal-h-cell.weekend .cal-h-wd { color: rgba(0,212,170,.5); }
.cal-h-cell.weekend .cal-h-d { color: #00d4aa; }
.cal-h-cell.today.weekend .cal-h-d { color: #000; }
.cal-h-dot {
  width: 8rpx; height: 8rpx;
  border-radius: 50%;
  background: #00d4aa;
  margin-top: 2rpx;
}

/* ===== Roster Grid ===== */
.roster {
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255,255,255,.01);
}

.roster-row {
  display: flex;
  min-height: 100rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
}
.roster-row:last-child { border-bottom: none; }

/* Today highlight */
.roster-row.today {
  background: rgba(0,212,170,.03);
}
.roster-row.today .roster-date {
  background: rgba(0,212,170,.08);
}

/* Weekend subtle */
.roster-row.weekend { background: rgba(0,212,170,.015); }

/* Date column */
.roster-date {
  width: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  border-right: 1rpx solid rgba(255,255,255,.04);
  flex-shrink: 0;
}
.roster-wd { font-size: 18rpx; color: rgba(255,255,255,.25); font-weight: 600; }
.roster-d { font-size: 28rpx; color: rgba(255,255,255,.6); font-weight: 800; }
.roster-row.today .roster-d { color: #00d4aa; }
.roster-row.today .roster-wd { color: rgba(0,212,170,.6); }

/* Content area */
.roster-content {
  flex: 1;
  padding: 10rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.roster-empty {
  display: flex;
  align-items: center;
  min-height: 60rpx;
}
.roster-dash { font-size: 24rpx; color: rgba(255,255,255,.1); }

/* ===== Roster Event Item ===== */
.roster-event {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 0;
}
.roster-event + .roster-event {
  border-top: 1rpx solid rgba(255,255,255,.03);
}
.roster-event.booked { opacity: .5; }

/* Color bar (left accent) */
.re-bar {
  width: 6rpx;
  border-radius: 3rpx;
  flex-shrink: 0;
  align-self: stretch;
}
.re-bar.bounty { background: #00d4aa; }
.re-bar.teambuilding { background: #ff9500; }
.re-bar.open { background: #7c4dff; }

/* Event body */
.re-body { flex: 1; min-width: 0; }

.re-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.re-time { font-size: 20rpx; color: rgba(255,255,255,.35); font-weight: 600; }
.re-tag {
  font-size: 18rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-weight: 700;
}
.open-tag { background: rgba(0,212,170,.12); color: #00d4aa; }
.closed-tag { background: rgba(255,255,255,.06); color: rgba(255,255,255,.3); }
.booked-tag { background: rgba(255,255,255,.04); color: rgba(255,255,255,.25); }

.re-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.re-name.dim { color: rgba(255,255,255,.4); }

.re-loc {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,.25);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 2rpx;
}

.re-action {
  display: block;
  font-size: 20rpx;
  color: #ff9500;
  font-weight: 700;
  margin-top: 6rpx;
}

.re-bottom {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}
.re-cap-bar {
  flex: 1;
  height: 6rpx;
  background: rgba(255,255,255,.06);
  border-radius: 3rpx;
  overflow: hidden;
  max-width: 200rpx;
}
.re-cap-fill {
  height: 100%;
  background: #00d4aa;
  border-radius: 3rpx;
}
.re-cap-text { font-size: 20rpx; color: rgba(255,255,255,.3); }

/* ===== Modals ===== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-body {
  width: 88%;
  max-height: 80vh;
  overflow-y: auto;
  background: #151922;
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 24rpx;
  padding: 36rpx;
}
.modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  text-align: center;
  margin-bottom: 12rpx;
}
.modal-event {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,.45);
  text-align: center;
  margin-bottom: 28rpx;
}

/* Form */
.form-group { margin-bottom: 20rpx; }
.form-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,.4);
  margin-bottom: 8rpx;
}
.form-input {
  width: 100%;
  padding: 18rpx 20rpx;
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.1);
  color: rgba(255,255,255,.5);
}
.modal-btn.submit {
  background: linear-gradient(135deg, #00d4aa, #7c4dff);
  color: #fff;
}

/* Detail */
.detail-body { max-height: 85vh; }
.detail-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
}
.dl { font-size: 24rpx; color: rgba(255,255,255,.35); width: 100rpx; flex-shrink: 0; }
.dv { font-size: 26rpx; color: rgba(255,255,255,.7); flex: 1; }

/* Player List */
.player-list { margin-top: 20rpx; }
.pl-title {
  display: block;
  font-size: 26rpx; font-weight: 700; color: #fff;
  margin-bottom: 12rpx;
}
.pl-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,.04);
}
.pl-idx { font-size: 22rpx; color: rgba(255,255,255,.3); width: 40rpx; }
.pl-name { font-size: 26rpx; color: rgba(255,255,255,.7); flex: 1; }
.pl-team { font-size: 22rpx; color: rgba(0,212,170,.6); }

/* Booking */
.tier-grid { display: flex; gap: 16rpx; margin-top: 12rpx; }
.tier-card {
  flex: 1;
  padding: 24rpx 12rpx;
  border: 2rpx solid rgba(255,255,255,.1);
  border-radius: 14rpx;
  text-align: center;
  background: rgba(255,255,255,.03);
}
.tier-card.selected {
  border-color: rgba(255,149,0,.5);
  background: rgba(255,149,0,.08);
}
.tier-num { display: block; font-size: 30rpx; font-weight: 800; color: #fff; }
.tier-sub { display: block; font-size: 20rpx; color: rgba(255,255,255,.35); margin-top: 4rpx; }

.deposit-box {
  background: rgba(255,215,0,.06);
  border: 1rpx solid rgba(255,215,0,.2);
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  margin: 20rpx 0;
}
.deposit-label { display: block; font-size: 22rpx; color: rgba(255,255,255,.4); }
.deposit-amount { display: block; font-size: 56rpx; font-weight: 900; color: #ffd700; margin: 8rpx 0; }
.deposit-note { display: block; font-size: 20rpx; color: rgba(255,255,255,.3); }

.modal-btn.gold {
  background: linear-gradient(135deg, #ffd700, #ff9500);
  color: #000;
}
