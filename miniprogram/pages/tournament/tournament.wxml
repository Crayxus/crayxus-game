<!-- 赛事报名 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">←</view>
    <text class="nav-title">赛事报名</text>
    <view class="nav-right"></view>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && events.length === 0}}">
    <text class="empty-icon">🏆</text>
    <text class="empty-text">暂无赛事安排</text>
    <text class="empty-sub">敬请期待下期活动</text>
  </view>

  <!-- 周导航 -->
  <view class="week-nav" wx:if="{{!loading}}">
    <view class="week-arrow" bindtap="prevWeek">←</view>
    <text class="week-label-text">{{weekLabel}}</text>
    <view class="week-arrow" bindtap="nextWeek">→</view>
  </view>

  <!-- 赛事列表 (按日期分组) -->
  <view class="event-list" wx:if="{{!loading && dayGroups.length > 0}}">
    <view wx:for="{{dayGroups}}" wx:key="date" class="day-group">
      <view class="day-header">
        <text class="day-date">{{item.label}}</text>
        <text class="day-weekday">{{item.weekday}}</text>
        <text class="day-today" wx:if="{{item.isToday}}">TODAY</text>
      </view>
      <view wx:if="{{item.events.length === 0}}" class="day-empty">暂无赛事</view>
      <view class="event-card" wx:for="{{item.events}}" wx:for-item="evt" wx:key="code" bindtap="showDetail" data-code="{{evt.code}}">
        <view class="ec-header">
          <view class="ec-type {{evt.eventType}}">{{evt.eventTypeText}}</view>
          <text class="ec-date">{{evt.eventTime}}</text>
        </view>
        <text class="ec-name">{{evt.name}}</text>
        <view class="ec-info">
          <text class="ec-location">📍 {{evt.location || '待定'}}</text>
          <text class="ec-fee">{{evt.fee ? '¥' + evt.fee : '免费'}}</text>
        </view>
        <view class="ec-capacity">
          <view class="ec-cap-bar">
            <view class="ec-cap-fill" style="width:{{evt.capPct}}%"></view>
          </view>
          <text class="ec-cap-text">{{evt.playerCount}}/{{evt.capacity}}人</text>
        </view>
        <view class="ec-status {{evt.status === 'open' ? 'open' : 'closed'}}">
          {{evt.status === 'open' ? '报名中' : evt.status === 'started' ? '进行中' : '已结束'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 报名弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-body" catchtap="">
      <text class="modal-title">报名参赛</text>
      <text class="modal-event">{{modalEvent.name}}</text>

      <view class="form-group">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="你的昵称" value="{{formNickname}}" bindinput="onNickname" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" placeholder="联系方式" type="number" value="{{formPhone}}" bindinput="onPhone" />
      </view>
      <view class="form-group">
        <text class="form-label">队伍</text>
        <input class="form-input" placeholder="队伍名称（可选）" value="{{formTeam}}" bindinput="onTeam" />
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{formNote}}" bindinput="onNote" />
      </view>

      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeModal">取消</view>
        <view class="modal-btn submit" bindtap="submitJoin">确认报名</view>
      </view>
    </view>
  </view>

  <!-- 赛事详情弹窗 -->
  <view class="modal-mask" wx:if="{{showDetail}}" bindtap="closeDetail">
    <view class="modal-body detail-body" catchtap="">
      <text class="modal-title">{{detailEvent.name}}</text>
      <view class="detail-row">
        <text class="dl">类型</text><text class="dv">{{detailEvent.eventTypeText}}</text>
      </view>
      <view class="detail-row">
        <text class="dl">时间</text><text class="dv">{{detailEvent.eventDate}} {{detailEvent.eventTime}}</text>
      </view>
      <view class="detail-row">
        <text class="dl">地点</text><text class="dv">{{detailEvent.location || '待定'}}</text>
      </view>
      <view class="detail-row">
        <text class="dl">费用</text><text class="dv">{{detailEvent.fee ? '¥' + detailEvent.fee : '免费'}}</text>
      </view>
      <view class="detail-row">
        <text class="dl">人数</text><text class="dv">{{detailEvent.playerCount}}/{{detailEvent.capacity}}</text>
      </view>
      <view class="detail-row" wx:if="{{detailEvent.description}}">
        <text class="dl">简介</text><text class="dv">{{detailEvent.description}}</text>
      </view>

      <!-- 已报名选手列表 -->
      <view class="player-list" wx:if="{{detailEvent.players && detailEvent.players.length}}">
        <text class="pl-title">已报名 ({{detailEvent.players.length}}人)</text>
        <view class="pl-row" wx:for="{{detailEvent.players}}" wx:key="index">
          <text class="pl-idx">{{index + 1}}</text>
          <text class="pl-name">{{item.nickname}}</text>
          <text class="pl-team" wx:if="{{item.team}}">{{item.team}}</text>
        </view>
      </view>

      <view class="modal-actions" wx:if="{{detailEvent.status === 'open'}}">
        <view class="modal-btn cancel" bindtap="closeDetail">关闭</view>
        <view class="modal-btn submit" bindtap="openJoinForm">我要报名</view>
      </view>
      <view class="modal-actions" wx:else>
        <view class="modal-btn cancel" bindtap="closeDetail">关闭</view>
      </view>
    </view>
  </view>

  <view style="height:120rpx"></view>
</view>
