<!-- 赛事日历 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">←</view>
    <text class="nav-title">赛事日历</text>
    <view class="nav-right"></view>
  </view>

  <!-- 月份导航 -->
  <view class="month-nav">
    <view class="month-arrow" bindtap="prevMonth">‹</view>
    <text class="month-label">{{monthLabel}}</text>
    <view class="month-arrow" bindtap="nextMonth">›</view>
  </view>

  <!-- 星期头 -->
  <view class="cal-weekdays">
    <text class="cal-wd">一</text>
    <text class="cal-wd">二</text>
    <text class="cal-wd">三</text>
    <text class="cal-wd">四</text>
    <text class="cal-wd">五</text>
    <text class="cal-wd we">六</text>
    <text class="cal-wd we">日</text>
  </view>

  <!-- 日历网格 -->
  <view class="cal-grid">
    <view
      class="cal-cell {{item.isToday ? 'today' : ''}} {{item.isOtherMonth ? 'other' : ''}} {{item.type}}"
      wx:for="{{calCells}}"
      wx:key="date"
      bindtap="onCellTap"
      data-date="{{item.date}}"
      data-type="{{item.type}}"
    >
      <text class="cell-d">{{item.d}}</text>
      <!-- 赛事标记 -->
      <view class="cell-tag bounty-tag" wx:if="{{item.type === 'bounty'}}">AI Bounty</view>
      <view class="cell-tag booked-tag" wx:if="{{item.type === 'booked'}}">已占</view>
      <view class="cell-tag avail-tag" wx:if="{{item.type === 'available'}}">可约</view>
      <view class="cell-tag open-tag" wx:if="{{item.type === 'open'}}">{{item.shortName || '赛事'}}</view>
      <!-- 空白天 -->
      <view class="cell-dot" wx:if="{{!item.type && !item.isOtherMonth && item.isWeekday}}"></view>
    </view>
  </view>

  <!-- 图例 -->
  <view class="legend">
    <view class="legend-item"><view class="legend-dot bounty"></view><text>AI Bounty（免费·击败AI赢奖金）</text></view>
    <view class="legend-item"><view class="legend-dot booked"></view><text>团建（已预约）</text></view>
    <view class="legend-item"><view class="legend-dot avail"></view><text>团建（可预约）</text></view>
  </view>

  <!-- 选中日期的事件详情 -->
  <view class="detail-card" wx:if="{{selectedEvent}}">
    <view class="dc-bar {{selectedEvent.eventType}}"></view>
    <view class="dc-body">
      <view class="dc-top">
        <text class="dc-name">{{selectedEvent.displayName}}</text>
        <text class="dc-tag {{selectedEvent.tagClass}}">{{selectedEvent.tagText}}</text>
      </view>
      <view class="dc-row" wx:if="{{selectedEvent.eventTime}}">
        <text class="dc-icon">🕐</text><text class="dc-text">{{selectedEvent.eventDate}} {{selectedEvent.eventTime}}</text>
      </view>
      <view class="dc-row" wx:if="{{selectedEvent.location}}">
        <text class="dc-icon">📍</text><text class="dc-text">{{selectedEvent.location}}</text>
      </view>
      <view class="dc-row" wx:if="{{selectedEvent.capacity}}">
        <text class="dc-icon">👥</text>
        <text class="dc-text">{{selectedEvent.playerCount || 0}}/{{selectedEvent.capacity}}人</text>
        <view class="dc-cap-bar" wx:if="{{selectedEvent.eventType !== 'teambuilding'}}">
          <view class="dc-cap-fill" style="width:{{selectedEvent.capPct || 0}}%"></view>
        </view>
      </view>
      <view class="dc-row" wx:if="{{selectedEvent.description}}">
        <text class="dc-icon">📝</text><text class="dc-text">{{selectedEvent.description}}</text>
      </view>

      <!-- 操作按钮 -->
      <view class="dc-actions" wx:if="{{selectedEvent.eventType === 'teambuilding' && selectedEvent.status !== 'booked'}}">
        <view class="dc-btn gold" bindtap="openBooking">预约团建 ¥100</view>
      </view>
      <view class="dc-actions" wx:if="{{selectedEvent.eventType !== 'teambuilding' && selectedEvent.status === 'open'}}">
        <view class="dc-btn primary" bindtap="showDetail" data-code="{{selectedEvent.code}}">查看详情 · 报名</view>
      </view>
    </view>
  </view>

  <!-- 报名弹窗 -->
  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-body" catchtap="">
      <text class="modal-title">报名参赛</text>
      <text class="modal-event">{{modalEvent.name}}</text>
      <view class="form-group">
        <text class="form-label">昵称</text>
        <input class="form-input" placeholder="你的昵称" value="{{formNickname}}" bindinput="onNickname" />
      </view>
      <view class="form-group">
        <text class="form-label">手机号</text>
        <input class="form-input" placeholder="联系方式" type="number" value="{{formPhone}}" bindinput="onPhone" />
      </view>
      <view class="form-group">
        <text class="form-label">队伍</text>
        <input class="form-input" placeholder="队伍名称（可选）" value="{{formTeam}}" bindinput="onTeam" />
      </view>
      <view class="form-group">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{formNote}}" bindinput="onNote" />
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeModal">取消</view>
        <view class="modal-btn submit" bindtap="submitJoin">确认报名</view>
      </view>
    </view>
  </view>

  <!-- 赛事详情弹窗 -->
  <view class="modal-mask" wx:if="{{showDetailModal}}" bindtap="closeDetailModal">
    <view class="modal-body detail-body" catchtap="">
      <text class="modal-title">{{detailEvent.name}}</text>
      <view class="detail-row"><text class="dl">类型</text><text class="dv">{{detailEvent.eventTypeText}}</text></view>
      <view class="detail-row"><text class="dl">时间</text><text class="dv">{{detailEvent.eventDate}} {{detailEvent.eventTime}}</text></view>
      <view class="detail-row"><text class="dl">地点</text><text class="dv">{{detailEvent.location || '待定'}}</text></view>
      <view class="detail-row"><text class="dl">人数</text><text class="dv">{{detailEvent.playerCount}}/{{detailEvent.capacity}}</text></view>
      <view class="detail-row" wx:if="{{detailEvent.description}}"><text class="dl">简介</text><text class="dv">{{detailEvent.description}}</text></view>
      <view class="player-list" wx:if="{{detailEvent.players && detailEvent.players.length}}">
        <text class="pl-title">已报名 ({{detailEvent.players.length}}人)</text>
        <view class="pl-row" wx:for="{{detailEvent.players}}" wx:key="index">
          <text class="pl-idx">{{index + 1}}</text>
          <text class="pl-name">{{item.nickname}}</text>
          <text class="pl-team" wx:if="{{item.team}}">{{item.team}}</text>
        </view>
      </view>
      <view class="modal-actions" wx:if="{{detailEvent.status === 'open'}}">
        <view class="modal-btn cancel" bindtap="closeDetailModal">关闭</view>
        <view class="modal-btn submit" bindtap="openJoinForm">我要报名</view>
      </view>
      <view class="modal-actions" wx:else>
        <view class="modal-btn cancel" bindtap="closeDetailModal">关闭</view>
      </view>
    </view>
  </view>

  <!-- 团建预约弹窗 -->
  <view class="modal-mask" wx:if="{{showBooking}}" bindtap="closeBooking">
    <view class="modal-body" catchtap="">
      <text class="modal-title">预约企业团建</text>
      <text class="modal-event">AI一体机 · 专业计分 · 茶歇配套</text>
      <view class="form-group">
        <text class="form-label">选择规模</text>
        <view class="tier-grid">
          <view class="tier-card {{bookingTier === 20 ? 'selected' : ''}}" bindtap="selectTier" data-tier="20">
            <text class="tier-num">20人</text><text class="tier-sub">5桌</text>
          </view>
          <view class="tier-card {{bookingTier === 40 ? 'selected' : ''}}" bindtap="selectTier" data-tier="40">
            <text class="tier-num">40人</text><text class="tier-sub">10桌</text>
          </view>
          <view class="tier-card {{bookingTier === 0 ? 'selected' : ''}}" bindtap="selectTier" data-tier="0">
            <text class="tier-num">定制</text><text class="tier-sub">自定义</text>
          </view>
        </view>
      </view>
      <view class="form-group">
        <text class="form-label">公司/团队名称</text>
        <input class="form-input" placeholder="例：xx科技有限公司" value="{{bkCompany}}" bindinput="onBkCompany" />
      </view>
      <view class="form-group">
        <text class="form-label">联系人</text>
        <input class="form-input" placeholder="姓名" value="{{bkContact}}" bindinput="onBkContact" />
      </view>
      <view class="form-group">
        <text class="form-label">联系电话</text>
        <input class="form-input" placeholder="手机号" type="number" value="{{bkPhone}}" bindinput="onBkPhone" />
      </view>
      <view class="deposit-box">
        <text class="deposit-label">预付定金</text>
        <text class="deposit-amount">¥100</text>
        <text class="deposit-note">支付后团建经理将在24h内联系您</text>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeBooking">取消</view>
        <view class="modal-btn submit gold" bindtap="submitBooking">支付 ¥100 预约</view>
      </view>
    </view>
  </view>

  <!-- 支付成功 -->
  <view class="modal-mask" wx:if="{{showPaySuccess}}" bindtap="closePaySuccess">
    <view class="modal-body" catchtap="" style="text-align:center">
      <text style="font-size:120rpx;display:block;margin:20rpx 0">✅</text>
      <text class="modal-title" style="color:#00d4aa">预约成功！</text>
      <text style="display:block;font-size:26rpx;color:rgba(255,255,255,.5);line-height:1.8;margin:20rpx 0">
        定金 ¥100 已收到\n团建经理将在24小时内联系您\n确认场地、时间和具体方案
      </text>
      <view class="modal-actions">
        <view class="modal-btn submit" bindtap="closePaySuccess">返回日历</view>
      </view>
    </view>
  </view>

  <view style="height:60rpx"></view>
</view>
