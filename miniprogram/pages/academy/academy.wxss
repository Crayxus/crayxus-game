page { background: #0a0e1a; }

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 100%);
}

/* Nav */
.nav-bar {
  display: flex; align-items: center; padding: 16rpx 0 24rpx;
}
.nav-back {
  font-size: 36rpx; color: rgba(255,255,255,.6); width: 60rpx; text-align: center;
}
.nav-title {
  flex: 1; font-size: 34rpx; font-weight: 800; color: #fff; text-align: center;
}

/* Header */
.academy-header {
  text-align: center; margin-bottom: 28rpx;
}
.academy-desc {
  font-size: 24rpx; color: rgba(255,255,255,.4); letter-spacing: 2rpx;
}

/* Course List */
.course-list { display: flex; flex-direction: column; gap: 20rpx; }
.course-card {
  display: flex; align-items: center; gap: 20rpx;
  padding: 28rpx 24rpx; border-radius: 20rpx;
  background: rgba(255,255,255,.03); border: 1rpx solid rgba(255,255,255,.06);
}
.course-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid; flex-shrink: 0;
}
.course-icon { font-size: 36rpx; }
.course-info { flex: 1; }
.course-name { display: block; font-size: 28rpx; font-weight: 700; color: #fff; margin-bottom: 4rpx; }
.course-desc { display: block; font-size: 20rpx; color: rgba(255,255,255,.35); margin-bottom: 10rpx; }
.course-progress-bar {
  height: 8rpx; background: rgba(255,255,255,.06); border-radius: 4rpx; overflow: hidden;
  margin-bottom: 6rpx;
}
.course-progress-fill { height: 100%; border-radius: 4rpx; }
.course-progress-text { font-size: 18rpx; font-weight: 600; }
.course-stars { display: flex; flex-direction: column; align-items: center; gap: 0; }
.star { font-size: 20rpx; color: rgba(255,255,255,.1); line-height: 1.2; }
.star.active { color: #ffd700; }

/* Lesson Header */
.lesson-header {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx; border-radius: 16rpx; margin-bottom: 24rpx;
  background: rgba(255,255,255,.03); border: 1rpx solid;
}
.lesson-header-icon { font-size: 48rpx; }
.lesson-header-name { display: block; font-size: 30rpx; font-weight: 700; color: #fff; }
.lesson-header-desc { display: block; font-size: 20rpx; color: rgba(255,255,255,.4); margin-top: 4rpx; }

/* Lesson List */
.lesson-list { display: flex; flex-direction: column; gap: 12rpx; }
.lesson-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 24rpx 20rpx; border-radius: 14rpx;
  background: rgba(255,255,255,.03); border: 1rpx solid rgba(255,255,255,.06);
}
.lesson-item.locked { opacity: 0.4; }
.lesson-item.done { background: rgba(255,255,255,.05); }
.lesson-num {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.06); font-size: 22rpx;
  color: rgba(255,255,255,.5); font-weight: 700; flex-shrink: 0;
}
.lesson-item.done .lesson-num { color: #fff; }
.lesson-info { flex: 1; }
.lesson-name { font-size: 26rpx; color: #fff; font-weight: 600; }
.lesson-tag { font-size: 18rpx; margin-left: 12rpx; }
.lesson-reward { font-size: 20rpx; color: #ffc800; font-weight: 600; }
