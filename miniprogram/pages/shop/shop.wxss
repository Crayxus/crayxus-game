page { background: #0a0e1a; }
.page { min-height: 100vh; padding: 0 24rpx; }

.shop-header { text-align: center; padding: 40rpx 0 20rpx; }
.shop-title { font-size: 40rpx; font-weight: 900; color: #58cc02; display: block; }
.shop-subtitle { font-size: 24rpx; color: #8899aa; display: block; margin-top: 8rpx; }

.device-card {
  background: linear-gradient(135deg, #1e3148, #1a2d42);
  border: 2rpx solid rgba(88,204,2,0.2);
  border-radius: 24rpx; padding: 32rpx;
  margin: 20rpx 0; text-align: center;
}
.device-img-area { margin-bottom: 16rpx; }
.device-name { font-size: 32rpx; font-weight: 800; color: #fff; display: block; }
.device-desc { font-size: 24rpx; color: #8899aa; display: block; margin: 8rpx 0 16rpx; line-height: 1.6; }
.device-tags { display: flex; gap: 12rpx; justify-content: center; }
.device-tag {
  font-size: 20rpx; color: #58cc02; padding: 6rpx 16rpx;
  border: 1rpx solid rgba(88,204,2,0.3); border-radius: 20rpx;
  background: rgba(88,204,2,0.08);
}

.section { margin: 20rpx 0; }
.section-title { font-size: 30rpx; font-weight: 800; color: #fff; display: block; margin-bottom: 16rpx; }

.plan-card {
  background: #1a2d42; border: 2rpx solid #2a4a6b;
  border-radius: 20rpx; padding: 24rpx; margin-bottom: 16rpx;
}
.plan-card.plan-hot { border-color: #58cc02; background: linear-gradient(135deg, #1e3148, #1a3520); }
.plan-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.plan-name { font-size: 28rpx; font-weight: 700; color: #fff; }
.plan-badge {
  font-size: 18rpx; padding: 4rpx 12rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.1); color: #8899aa;
}
.plan-badge.hot { background: rgba(88,204,2,0.2); color: #58cc02; }
.plan-price-row { display: flex; align-items: baseline; gap: 4rpx; }
.plan-price { font-size: 44rpx; font-weight: 900; color: #ffc800; }
.plan-unit { font-size: 22rpx; color: #8899aa; }
.plan-note { font-size: 22rpx; color: #667; display: block; margin-top: 8rpx; }

.info-list { display: flex; flex-direction: column; gap: 16rpx; }
.info-item {
  display: flex; align-items: flex-start; gap: 16rpx;
  padding: 16rpx; background: #1a2d42; border-radius: 16rpx;
}
.info-icon { font-size: 28rpx; width: 40rpx; text-align: center; flex-shrink: 0; margin-top: 4rpx; }
.info-label { font-size: 24rpx; color: #58cc02; display: block; font-weight: 600; }
.info-val { font-size: 24rpx; color: #a0b0c0; display: block; margin-top: 4rpx; }

.contact-card {
  background: linear-gradient(135deg, rgba(88,204,2,0.1), rgba(88,204,2,0.03));
  border: 2rpx solid rgba(88,204,2,0.2);
  border-radius: 24rpx; padding: 32rpx; text-align: center;
}
.contact-text { font-size: 26rpx; color: #a0b0c0; display: block; margin-bottom: 16rpx; }
.contact-email-big { font-size: 32rpx; color: #58cc02; font-weight: 700; display: block; margin-bottom: 20rpx; }
.contact-btn {
  background: #58cc02 !important; color: #0a0e1a !important;
  border: none !important; border-radius: 16rpx !important;
  font-size: 28rpx !important; font-weight: 700 !important;
  padding: 16rpx 48rpx !important;
}
