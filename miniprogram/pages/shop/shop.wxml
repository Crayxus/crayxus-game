<!-- 设备租赁 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- 头部 -->
  <view class="shop-header">
    <text class="shop-title">🖥️ 设备租赁</text>
    <text class="shop-subtitle">AI 掼蛋大师 · 专业赛事设备</text>
  </view>

  <!-- 设备卡片 -->
  <view class="device-card">
    <view class="device-img-area">
      <text style="font-size:64px">🖥️</text>
    </view>
    <view class="device-info">
      <text class="device-name">掼蛋智能一体机</text>
      <text class="device-desc">13.3寸触控屏 · AI对战 · 赛事管理 · 即插即用</text>
      <view class="device-tags">
        <text class="device-tag">触控操作</text>
        <text class="device-tag">AI内置</text>
        <text class="device-tag">赛事模式</text>
      </view>
    </view>
  </view>

  <!-- 租赁方案 -->
  <view class="section">
    <text class="section-title">租赁方案</text>

    <view class="plan-card" bindtap="selectPlan" data-plan="day">
      <view class="plan-header">
        <text class="plan-name">单日租赁</text>
        <text class="plan-badge">灵活</text>
      </view>
      <view class="plan-price-row">
        <text class="plan-price">¥200</text>
        <text class="plan-unit">/台/天</text>
      </view>
      <text class="plan-note">适合小型聚会、单场活动</text>
    </view>

    <view class="plan-card plan-hot" bindtap="selectPlan" data-plan="weekend">
      <view class="plan-header">
        <text class="plan-name">周末套餐</text>
        <text class="plan-badge hot">推荐</text>
      </view>
      <view class="plan-price-row">
        <text class="plan-price">¥500</text>
        <text class="plan-unit">/台/周末(2天)</text>
      </view>
      <text class="plan-note">适合企业团建、周末赛事</text>
    </view>

    <view class="plan-card" bindtap="selectPlan" data-plan="week">
      <view class="plan-header">
        <text class="plan-name">周租赁</text>
        <text class="plan-badge">超值</text>
      </view>
      <view class="plan-price-row">
        <text class="plan-price">¥1,200</text>
        <text class="plan-unit">/台/周</text>
      </view>
      <text class="plan-note">适合长期赛事、展会活动</text>
    </view>
  </view>

  <!-- 租赁须知 -->
  <view class="section">
    <text class="section-title">租赁须知</text>
    <view class="info-list">
      <view class="info-item">
        <text class="info-icon">📦</text>
        <view>
          <text class="info-label">起租数量</text>
          <text class="info-val">最少 4 台起租</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-icon">💰</text>
        <view>
          <text class="info-label">押金</text>
          <text class="info-val">每台 ¥2,000（退还时全额退还）</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-icon">🚚</text>
        <view>
          <text class="info-label">配送</text>
          <text class="info-val">杭州市内免费配送安装</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-icon">🔧</text>
        <view>
          <text class="info-label">技术支持</text>
          <text class="info-val">现场技术人员全程保障</text>
        </view>
      </view>
      <view class="info-item">
        <text class="info-icon">📋</text>
        <view>
          <text class="info-label">包含服务</text>
          <text class="info-val">设备 + 网络 + AI系统 + 赛事管理</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系租赁 -->
  <view class="section">
    <text class="section-title">联系租赁</text>
    <view class="contact-card">
      <text class="contact-text">如需租赁设备，请联系我们</text>
      <text class="contact-email-big" style="user-select:text">general@crayxus.com.au</text>
      <button class="contact-btn" bindtap="copyEmail">复制邮箱</button>
    </view>
  </view>

  <view style="height:120rpx"></view>
</view>
