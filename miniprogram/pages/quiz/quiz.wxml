<!-- 蛋力值测评 / 每日做题 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- 顶部导航 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">←</view>
    <text class="nav-title">{{mode === 'danli' ? '段位测评' : mode === 'lesson' ? lessonName : '每日做题'}}</text>
    <view class="nav-right">
      <text class="nav-progress" wx:if="{{started}}">{{currentIndex + 1}}/{{questions.length}}</text>
    </view>
  </view>

  <!-- 开始页 -->
  <view class="start-page" wx:if="{{!started && !finished}}">
    <view class="start-icon">{{mode === 'danli' ? '🎯' : mode === 'lesson' ? '📖' : '📝'}}</view>
    <view class="start-title">{{mode === 'danli' ? '段位测评' : mode === 'lesson' ? lessonName : '每日做题'}}</view>
    <view class="start-desc" wx:if="{{mode === 'danli'}}">
      20道真实牌局，V8 超冠军级AI出题\n随机题目，每次不同\n组牌 · 大牌 · 时机 · 配合 · 炸弹 · 终局
    </view>
    <view class="start-desc" wx:elif="{{mode === 'lesson'}}">
      {{lessonDim}} · 5道题 · 60分及格解锁下一课\n满分额外奖励蛋力Token
    </view>
    <view class="start-desc" wx:else>
      每天3道精选题目，坚持练习提升实力
    </view>
    <view class="start-btn" bindtap="startQuiz">{{poolLoaded ? '开始答题' : '加载题库中...'}}</view>
  </view>

  <!-- 答题中 -->
  <view class="quiz-body" wx:if="{{started && !finished}}">
    <!-- 进度条 -->
    <view class="progress-bar">
      <view class="progress-fill" style="width:{{(currentIndex + 1) / questions.length * 100}}%"></view>
    </view>

    <!-- 维度标签 -->
    <view class="dim-tag" style="background:{{currentQ.dimColor}}22;color:{{currentQ.dimColor}};border:1rpx solid {{currentQ.dimColor}}44">
      {{currentQ.dim}}
    </view>

    <!-- 场景描述 -->
    <text class="scenario-text">{{currentQ.scenario}}</text>

    <!-- 上一手牌（如有） -->
    <view class="last-play-area" wx:if="{{currentQ.lastPlay && currentQ.lastPlay.length > 0}}">
      <text class="last-play-label">上一手出牌：</text>
      <view class="card-row">
        <view class="poker-card" wx:for="{{currentQ.lastPlay}}" wx:key="index" style="color:{{item.color}}">
          <text class="pc-val">{{item.val}}</text>
          <text class="pc-suit" wx:if="{{item.v < 16}}">{{item.suit}}</text>
        </view>
      </view>
    </view>

    <!-- 你的手牌 -->
    <view class="hand-area">
      <text class="hand-label">你的手牌：</text>
      <view class="card-row hand-cards">
        <view class="poker-card" wx:for="{{currentQ.hand}}" wx:key="index" style="color:{{item.color}}">
          <text class="pc-val">{{item.val}}</text>
          <text class="pc-suit" wx:if="{{item.v < 16}}">{{item.suit}}</text>
        </view>
      </view>
    </view>

    <!-- 题目 -->
    <text class="q-text">{{currentQ.question}}</text>

    <!-- 选项 -->
    <view class="q-options">
      <view
        class="q-option {{selectedAnswer === idx ? (showResult ? (currentQ.options[idx].correct ? 'correct' : 'wrong') : 'selected') : (showResult && currentQ.options[idx].correct ? 'correct' : '')}}"
        wx:for="{{currentQ.options}}"
        wx:key="index"
        wx:for-index="idx"
        data-idx="{{idx}}"
        bindtap="selectAnswer"
      >
        <text class="opt-letter">{{['A','B','C','D'][idx]}}</text>
        <view class="opt-content">
          <!-- 选项牌面 -->
          <view class="opt-cards" wx:if="{{item.cards && item.cards.length > 0}}">
            <view class="poker-card-sm" wx:for="{{item.cards}}" wx:for-item="card" wx:key="index" style="color:{{card.color}}">
              <text class="pcs-val">{{card.val}}</text>
              <text class="pcs-suit" wx:if="{{card.v < 16}}">{{card.suit}}</text>
            </view>
          </view>
          <text class="opt-text" wx:else>{{item.text}}</text>
        </view>
      </view>
    </view>

    <!-- 解析（仅每日做题模式） -->
    <view class="explain-card" wx:if="{{showResult && mode !== 'danli'}}">
      <text class="explain-title">{{currentQ.options[selectedAnswer].correct ? '✓ 正确' : '✗ 错误'}}</text>
      <text class="explain-text">{{currentQ.options[selectedAnswer].explain || ''}}</text>
    </view>

    <!-- 下一题按钮（仅每日做题） -->
    <view class="next-btn" wx:if="{{showResult && mode !== 'danli'}}" bindtap="nextQuestion">
      {{currentIndex < questions.length - 1 ? '下一题 →' : '查看结果'}}
    </view>
  </view>

  <!-- 结果页：证书风格 -->
  <view class="result-page" wx:if="{{finished}}">

    <!-- 课程答题结果 -->
    <view wx:if="{{mode === 'lesson'}}" style="text-align:center;padding-top:80rpx">
      <view style="font-size:80rpx;margin-bottom:20rpx">{{result.passed ? '🎉' : '😅'}}</view>
      <text class="result-score" style="font-size:96rpx;color:{{result.passed ? '#58cc02' : '#ff4444'}}">{{result.pct}}</text>
      <text class="result-max" style="font-size:36rpx;color:#888">分</text>
      <view style="margin-top:16rpx;font-size:30rpx;color:#ccc">{{result.lessonName}} · {{result.dim}}</view>
      <view style="margin-top:12rpx;font-size:26rpx;color:{{result.passed ? '#58cc02' : '#ff4444'}}">
        {{result.passed ? '通过！' : '未及格，60分通过'}} · {{result.correct}}/{{result.total}}题正确
      </view>
      <view wx:if="{{result.passed && result.bonus > 0}}" style="margin-top:20rpx;font-size:28rpx;color:#ffc800">
        🥚 +{{result.bonus}} 蛋力Token {{result.pct === 100 ? '· 满分奖励！' : ''}}
      </view>
      <view class="result-actions" style="margin-top:60rpx">
        <view class="result-btn primary" bindtap="{{result.passed ? 'goBack' : 'retryQuiz'}}">
          {{result.passed ? '返回课程' : '再试一次'}}
        </view>
      </view>
    </view>

    <!-- 每日做题简单结果 -->
    <view wx:if="{{mode !== 'danli' && mode !== 'lesson'}}" style="text-align:center;padding-top:120rpx">
      <text class="result-score" style="font-size:96rpx">{{result.correct}}</text>
      <text class="result-max">/{{result.total}}</text>
      <text class="result-correct" style="display:block;margin-top:20rpx">答对 {{result.correct}} 题</text>
      <view class="result-actions" style="margin-top:60rpx">
        <view class="result-btn primary" bindtap="retryQuiz">再来一次</view>
        <view class="result-btn" bindtap="goBack">返回</view>
      </view>
    </view>

    <!-- 蛋力测评证书 -->
    <view class="cert-outer" wx:if="{{mode === 'danli'}}">
      <view class="cert-gold-border">
        <view class="cert-inner">
          <view class="cert-watermark"></view>
          <view class="cert-watermark-sm"></view>

          <view class="cert-top-line">
            <view class="cert-line-bar"></view>
            <text class="cert-top-label">CRAYXUS AI</text>
            <view class="cert-line-bar"></view>
          </view>

          <text class="cert-title">掼蛋段位认证</text>
          <text class="cert-subtitle">Crayxus AI 掼蛋能力认证中心</text>

          <view class="cert-divider"></view>

          <view class="cert-rank-area">
            <text class="cert-rank-icon">{{result.rankIcon}}</text>
            <text class="cert-rank-name" style="color:{{result.rankColor}}">{{result.rank}}</text>
            <text class="cert-rating">{{result.rating}}</text>
            <text class="cert-rating-label">综合评分 · {{result.correct}}/{{result.total}} 正确率 {{result.pct}}%</text>
          </view>

          <view class="cert-divider"></view>

          <text class="cert-dim-title">六 维 能 力 评 估</text>
          <view class="cert-dims">
            <view class="cert-dim" wx:for="{{result.dims}}" wx:key="key">
              <text class="cd-icon">{{item.icon}}</text>
              <text class="cd-name">{{item.name}}</text>
              <view class="cd-bar">
                <view class="cd-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view>
              </view>
              <text class="cd-val" style="color:{{item.color}}">{{item.pct}}%</text>
            </view>
          </view>

          <view class="cert-weak">
            <text class="cert-weak-title">待提升维度：{{result.weakest}}</text>
            <text class="cert-weak-desc">建议通过蛋力学院重点练习该维度策略</text>
          </view>

          <view class="cert-footer">
            <view class="cert-info">
              <text class="cert-info-line">认证编号：{{result.certNo}}</text>
              <text class="cert-info-line">评估日期：{{result.certDate}}</text>
              <text class="cert-info-line">评估模型：V8 超冠军级 AI</text>
            </view>
            <view class="cert-stamp">
              <text class="cert-stamp-t1">CRAYXUS</text>
              <text class="cert-stamp-t2">AI认证</text>
              <text class="cert-stamp-t3">专用章</text>
            </view>
          </view>

          <view class="cert-bottom-line">
            <view class="cert-line-bar-sm"></view>
            <text class="cert-slogan">以AI之智 行大师之道</text>
            <view class="cert-line-bar-sm"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="cert-actions" wx:if="{{mode === 'danli'}}">
      <view class="cert-btn-secondary" bindtap="goBack">返回</view>
      <view class="cert-btn-primary" bindtap="retryQuiz">重新测评</view>
    </view>
  </view>
</view>
