page {
  background: #05070d;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}
.page {
  min-height: 100vh;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #05070d, #0a0e1a 60%, #0d1220);
}

/* ============ AI 加载 overlay（丝滑进度条）============ */
.ai-loading {
  padding: 80rpx 24rpx 60rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ai-game-hint {
  margin-top: 36rpx;
  margin-bottom: 16rpx;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(0,212,170,.12);
  border: 1rpx solid rgba(0,212,170,.3);
}
.ai-game-hint text {
  font-size: 22rpx;
  color: #00d4aa;
  letter-spacing: 1rpx;
}
.ai-ring {
  width: 140rpx; height: 140rpx;
  margin-bottom: 40rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(0,234,255,.12);
  border-top-color: #00eaff;
  border-right-color: #7c4dff;
  animation: ai-spin 1.1s linear infinite;
  box-shadow: 0 0 30rpx rgba(0,234,255,.35);
}
@keyframes ai-spin { to { transform: rotate(360deg); } }
.ai-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  background: linear-gradient(90deg, #00eaff, #ffd700);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 14rpx;
}
.ai-msg {
  font-size: 24rpx;
  color: rgba(255,255,255,.65);
  letter-spacing: 1rpx;
  margin-bottom: 40rpx;
  min-height: 34rpx;
}
.ai-bar-wrap {
  width: 100%;
  height: 14rpx;
  background: rgba(0,234,255,.08);
  border: 1rpx solid rgba(0,234,255,.2);
  border-radius: 999rpx;
  overflow: hidden;
  position: relative;
  margin-bottom: 14rpx;
}
.ai-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #00eaff 0%, #7c4dff 50%, #ffd700 100%);
  border-radius: 999rpx;
  box-shadow: 0 0 20rpx rgba(0,234,255,.55);
  transition: width .25s cubic-bezier(.4,.2,.2,1);
  position: relative;
}
.ai-bar-fill::after {
  content: '';
  position: absolute;
  top: 0; bottom: 0; right: 0;
  width: 60rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.45));
  animation: ai-shimmer 1.2s ease-in-out infinite;
}
@keyframes ai-shimmer {
  0%,100% { opacity: .4; }
  50%     { opacity: 1; }
}
.ai-pct {
  font-size: 28rpx;
  font-weight: 800;
  color: #00eaff;
  font-family: "Helvetica Neue", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  margin-bottom: 36rpx;
  text-shadow: 0 0 14rpx rgba(0,234,255,.45);
}
.ai-stages {
  display: flex;
  gap: 10rpx;
  width: 100%;
  justify-content: center;
}
.ai-stage {
  flex: 1;
  padding: 14rpx 6rpx;
  border-radius: 20rpx;
  background: rgba(0,234,255,.04);
  border: 1rpx solid rgba(0,234,255,.15);
  text-align: center;
  transition: all .3s ease;
}
.ai-stage text {
  font-size: 22rpx;
  color: rgba(255,255,255,.5);
  letter-spacing: 2rpx;
  font-weight: 600;
}
.ai-stage.done {
  background: linear-gradient(135deg, rgba(0,234,255,.22), rgba(124,77,255,.15));
  border-color: #00eaff;
  box-shadow: 0 0 14rpx rgba(0,234,255,.35);
}
.ai-stage.done text { color: #00eaff; font-weight: 700; }

/* ============ 听力音频播放器 ============ */
.audio-player {
  background: linear-gradient(135deg, rgba(0,212,170,.12), rgba(124,77,255,.08));
  border: 1rpx solid rgba(0,212,170,.3);
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}
.ap-wave {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 6rpx;
  height: 60rpx;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}
.ap-bar {
  width: 8rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #00d4aa, #7c4dff);
  border-radius: 4rpx;
  box-shadow: 0 0 8rpx rgba(0,212,170,.4);
}
.ap-bar.playing {
  animation: ap-bounce 0.9s ease-in-out infinite alternate;
}
@keyframes ap-bounce {
  0%   { height: 12rpx; opacity: 0.4; }
  100% { height: 54rpx; opacity: 1; }
}

.ap-controls {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.ap-play-btn {
  flex-shrink: 0;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00d4aa, #7c4dff);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,212,170,.35);
  transition: transform .15s ease;
}
.ap-play-btn:active { transform: scale(.92); }
.ap-play-btn text {
  color: #fff;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}
.ap-info { flex: 1; }
.ap-title {
  display: block;
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.ap-meta {
  display: block;
  font-size: 20rpx;
  color: rgba(255,255,255,.55);
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.ap-subtitle-btn {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,.05);
  border: 1rpx solid rgba(255,255,255,.15);
  transition: all .2s ease;
}
.ap-subtitle-btn text {
  font-size: 22rpx;
  color: rgba(255,255,255,.7);
  letter-spacing: 2rpx;
  font-weight: 600;
}
.ap-subtitle-btn.active {
  background: rgba(255,215,0,.15);
  border-color: rgba(255,215,0,.45);
}
.ap-subtitle-btn.active text { color: #ffd700; }

.ap-subtitle {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  background: rgba(0,0,0,.35);
  border-radius: 16rpx;
  border-left: 3rpx solid #ffd700;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ap-subtitle text {
  font-size: 24rpx;
  color: rgba(255,255,255,.82);
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}
.ap-subtitle-zh {
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(255,215,0,.3);
  color: rgba(255,215,0,.85) !important;
  font-size: 22rpx !important;
}

/* 题干 + 翻译 + 生词本 */
.q-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.q-row .q-text { flex: 1; margin-bottom: 0 !important; }
.q-actions { display: flex; flex-direction: column; gap: 8rpx; flex-shrink: 0; }
.q-trans-btn, .q-vocab-btn {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: rgba(0,212,170,.15);
  border: 1rpx solid rgba(0,212,170,.4);
}
.q-trans-btn.active {
  background: rgba(255,215,0,.18);
  border-color: rgba(255,215,0,.5);
}
.q-trans-btn text { font-size: 22rpx; }
.q-vocab-btn {
  background: rgba(124,77,255,.15);
  border-color: rgba(124,77,255,.4);
}
.q-vocab-btn.saved {
  background: linear-gradient(135deg, rgba(124,77,255,.4), rgba(0,234,255,.3));
  border-color: rgba(124,77,255,.7);
}
.q-vocab-btn text { font-size: 24rpx; color: #fff; }

/* 🎁 盲盒奖励弹窗 */
.reward-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.85);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: rewardFadeIn 0.3s ease;
}
@keyframes rewardFadeIn { from { opacity: 0 } to { opacity: 1 } }

.reward-box {
  width: 80%;
  max-width: 560rpx;
  padding: 60rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #1a0a2e, #0a0e2a);
  border: 2rpx solid rgba(255,215,0,.5);
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.6), 0 0 60rpx rgba(255,215,0,.3);
  text-align: center;
}
.rb-closed { display: flex; flex-direction: column; align-items: center; }
.rb-title {
  font-size: 28rpx;
  color: #ffd700;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 30rpx;
}
.rb-emoji {
  font-size: 200rpx;
  line-height: 1;
  animation: shake 0.6s ease-in-out infinite;
  margin-bottom: 24rpx;
}
@keyframes shake {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(-8deg); }
  75% { transform: rotate(8deg); }
}
.rb-tip {
  font-size: 24rpx;
  color: rgba(255,255,255,.7);
  letter-spacing: 1rpx;
}

.rb-opened {
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: rewardPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.rb-opened.rare {
  background: linear-gradient(135deg, rgba(255,215,0,.15), rgba(124,77,255,.1));
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
}
@keyframes rewardPop {
  from { transform: scale(0.5); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.ro-icon {
  font-size: 160rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}
.ro-label {
  font-size: 36rpx;
  color: #fff;
  font-weight: 800;
  letter-spacing: 2rpx;
  margin-bottom: 14rpx;
  text-align: center;
}
.ro-rare {
  font-size: 24rpx;
  color: #ffd700;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-bottom: 30rpx;
  animation: shimmer 1.5s ease-in-out infinite;
}
@keyframes shimmer {
  0%, 100% { opacity: 0.7; }
  50% { opacity: 1; }
}
.ro-close {
  margin-top: 16rpx;
  padding: 18rpx 40rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd700, #ff8c00);
  color: #1a0a0a;
}
.ro-close text {
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #1a0a0a;
}
.q-translation {
  margin: 16rpx 0 24rpx;
  padding: 18rpx 22rpx;
  background: rgba(255,215,0,.08);
  border-radius: 14rpx;
  border-left: 3rpx solid #ffd700;
}
.q-translation text {
  font-size: 26rpx;
  color: rgba(255,215,0,.92);
  line-height: 1.65;
  letter-spacing: 0.5rpx;
}

/* Top */
.top-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0 24rpx;
}
.close-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.06);
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 50%;
  color: #fff; font-size: 28rpx;
}
.progress-wrap {
  flex: 1;
  height: 10rpx;
  background: rgba(255,255,255,.06);
  border-radius: 5rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00d4aa, #7c4dff);
  border-radius: 5rpx;
  transition: width .4s ease;
}
.progress-txt {
  font-size: 22rpx;
  color: rgba(255,255,255,.5);
  font-family: "Helvetica Neue", "PingFang SC", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0;
  min-width: 80rpx;
  text-align: right;
}

/* Mode */
.mode-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}
.mode-tag {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.mode-tag.assess { background: rgba(0,212,170,.12); color: #00d4aa; border: 1rpx solid rgba(0,212,170,.3); }
.mode-tag.adaptive { background: rgba(255,0,128,.12); color: #ff0080; border: 1rpx solid rgba(255,0,128,.3); }
.lesson-tag {
  font-size: 20rpx;
  color: rgba(255,255,255,.4);
  padding: 6rpx 12rpx;
  background: rgba(255,255,255,.04);
  border-radius: 6rpx;
}

/* Question card */
.q-card {
  padding: 32rpx 28rpx;
  background: rgba(255,255,255,.03);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.q-num {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 900;
  color: #7c4dff;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}
.q-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  color: #fff;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.opt-list { display: flex; flex-direction: column; gap: 14rpx; }
.opt-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  background: rgba(255,255,255,.03);
  border: 2rpx solid rgba(255,255,255,.08);
  border-radius: 14rpx;
}
.opt-row.selected {
  background: rgba(0,212,170,.08);
  border-color: rgba(0,212,170,.5);
}
.opt-row.correct {
  background: rgba(0,212,170,.14);
  border-color: #00d4aa;
}
.opt-row.wrong {
  background: rgba(255,107,107,.14);
  border-color: #ff6b6b;
}
.opt-letter {
  width: 44rpx; height: 44rpx;
  display: flex; align-items: center; justify-content: center;
  background: rgba(255,255,255,.08);
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(255,255,255,.7);
}
.opt-row.selected .opt-letter { background: rgba(0,212,170,.25); color: #00d4aa; }
.opt-row.correct .opt-letter { background: #00d4aa; color: #05070d; }
.opt-row.wrong .opt-letter { background: #ff6b6b; color: #fff; }
.opt-text {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
.opt-mark {
  font-size: 32rpx;
  font-weight: 900;
  color: #00d4aa;
}
.opt-mark.wrong { color: #ff6b6b; }

/* Solution */
.solution {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(124,77,255,.08);
  border-left: 4rpx solid #7c4dff;
  border-radius: 8rpx;
}
.sol-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #7c4dff;
  margin-bottom: 8rpx;
}
.sol-text {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,.8);
  line-height: 1.6;
}

/* Bottom */
.bottom-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  padding: 20rpx 24rpx 40rpx;
  background: linear-gradient(180deg, transparent, #0a0e1a 40%);
}
.next-btn {
  padding: 28rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #00d4aa, #7c4dff);
  box-shadow: 0 8rpx 30rpx rgba(0,212,170,.25);
  letter-spacing: 2rpx;
}
.next-btn.disabled {
  background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.3);
  box-shadow: none;
}

/* Result overlay */
.result-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.85);
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  z-index: 99;
}
.result-card {
  width: 100%;
  padding: 40rpx 32rpx;
  background: linear-gradient(180deg, rgba(0,212,170,.1), rgba(124,77,255,.1));
  border: 1rpx solid rgba(0,212,170,.3);
  border-radius: 24rpx;
}
.result-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
  letter-spacing: 3rpx;
  opacity: .9;
}
.score-ring {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin: 24rpx 0 8rpx;
}
.score-big {
  font-size: 110rpx;
  font-weight: 900;
  color: #00d4aa;
  font-family: "Helvetica Neue", "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: -2rpx;
  line-height: 1;
  text-shadow: 0 0 28rpx rgba(0,212,170,.35);
}
.score-max {
  font-size: 26rpx;
  color: rgba(255,255,255,.35);
  margin-left: 6rpx;
  font-family: "Helvetica Neue", "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
  font-weight: 500;
}
.result-sub {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,.55);
  margin: 6rpx 0 24rpx;
  letter-spacing: 1rpx;
  font-family: "Helvetica Neue", "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
}

.dim-result-list {
  display: flex; flex-direction: column; gap: 14rpx;
  padding: 20rpx;
  background: rgba(0,0,0,.35);
  border-radius: 14rpx;
}
.dim-result-row { display: flex; align-items: center; gap: 12rpx; }
.drr-icon { font-size: 26rpx; width: 36rpx; text-align: center; }
.drr-name { font-size: 24rpx; color: rgba(255,255,255,.75); width: 88rpx; font-weight: 500; }
.drr-bar { flex: 1; height: 10rpx; background: rgba(255,255,255,.06); border-radius: 999rpx; overflow: hidden; }
.drr-fill { height: 100%; border-radius: 999rpx; transition: width .6s ease; }
.drr-val { font-size: 24rpx; font-weight: 700; width: 80rpx; text-align: right; font-family: "Helvetica Neue", "PingFang SC", sans-serif; font-variant-numeric: tabular-nums; letter-spacing: 0; }

.weak-tip {
  margin-top: 20rpx;
  padding: 14rpx 20rpx;
  background: rgba(255,107,107,.1);
  border: 1rpx solid rgba(255,107,107,.25);
  border-radius: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(255,255,255,.7);
}
.weak-name { color: #ff6b6b; font-weight: 800; }

.result-actions {
  display: flex; gap: 14rpx; margin-top: 24rpx;
}
.result-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 14rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
}
.result-btn.ghost {
  background: rgba(255,255,255,.06);
  border: 1rpx solid rgba(255,255,255,.12);
  color: #fff;
}
.result-btn.primary {
  background: linear-gradient(135deg, #ff0080, #7c4dff);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(255,0,128,.3);
}
