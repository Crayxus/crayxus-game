<!-- 掼蛋首页 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- Header -->
  <view class="header">
    <text class="header-title">AI 掼蛋大师</text>
    <view class="header-right">
      <view class="egg-token-btn" bindtap="showEggWallet">
        <text style="font-size:16px">🥚</text>
        <text class="egg-token-val">{{eggBalance || 100}}</text>
      </view>
      <view class="scan-btn" bindtap="onScanLogin">
        <text class="scan-icon">⊞</text>
      </view>
    </view>
  </view>

  <!-- 蛋力值卡片 -->
  <view class="danli-card" bindtap="goDanli">
    <view class="danli-left">
      <view class="danli-label">我的蛋力值</view>
      <view class="danli-score-row">
        <text class="danli-score">{{danli.score || '--'}}</text>
        <text class="danli-max">/1000</text>
      </view>
      <text class="danli-rank">{{danli.rank || '尚未测评'}}</text>
    </view>
    <view class="danli-right">
      <canvas canvas-id="radar" id="radar" style="width:140rpx;height:140rpx"></canvas>
      <text class="danli-test-btn" wx:if="{{!danli.score}}">立即测评 →</text>
      <text class="danli-test-btn" wx:else>重新测评 →</text>
    </view>
  </view>

  <!-- 功能入口 (3个: 蛋力测评 / 赛事记录 / 赛事报名) -->
  <view class="entry-grid three-col">
    <view class="entry-card entry-danli" bindtap="goDanli">
      <text class="entry-icon">🎯</text>
      <text class="entry-name">蛋力测评</text>
      <text class="entry-desc">18题测出实力</text>
    </view>
    <view class="entry-card entry-daily" bindtap="goTournament">
      <text class="entry-icon">📊</text>
      <text class="entry-name">赛事记录</text>
      <text class="entry-desc">MTT 战绩追踪</text>
    </view>
    <view class="entry-card entry-tournament" bindtap="goTournament">
      <text class="entry-icon">🏆</text>
      <text class="entry-name">赛事报名</text>
      <text class="entry-desc">MTT · AI大乱斗</text>
    </view>
  </view>

  <!-- 六维能力详情 -->
  <view class="section" wx:if="{{danli.score}}">
    <view class="section-title">能力雷达</view>
    <view class="dim-list">
      <view class="dim-row" wx:for="{{dims}}" wx:key="key">
        <text class="dim-icon">{{item.icon}}</text>
        <text class="dim-name">{{item.name}}</text>
        <view class="dim-bar">
          <view class="dim-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view>
        </view>
        <text class="dim-val" style="color:{{item.color}}">{{item.val}}</text>
      </view>
    </view>
  </view>

  <!-- MTT 赛事战绩 -->
  <view class="section">
    <view class="section-title">MTT 赛事战绩</view>
    <view class="stat-grid">
      <view class="stat-item">
        <text class="stat-val">{{mtt.totalEvents || 0}}</text>
        <text class="stat-label">参赛场次</text>
      </view>
      <view class="stat-item">
        <text class="stat-val">{{mtt.bestRank || '--'}}</text>
        <text class="stat-label">最佳名次</text>
      </view>
      <view class="stat-item">
        <text class="stat-val">{{mtt.itm || 0}}</text>
        <text class="stat-label">ITM次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-val">{{mtt.totalScore || 0}}</text>
        <text class="stat-label">累计积分</text>
      </view>
    </view>
  </view>

  <!-- 每周 AI 对战日程 -->
  <view class="section">
    <view class="section-title">本周 AI 对手</view>
    <view class="ai-week-row">
      <view class="ai-day-mini {{item.isToday ? 'today' : ''}}" wx:for="{{aiSchedule}}" wx:key="day">
        <text class="ai-day-label">{{item.day}}</text>
        <text class="ai-day-logo">{{item.logo}}</text>
        <text class="ai-day-name" style="color:{{item.isToday ? '#00d4aa' : item.color}}">{{item.ai}}</text>
      </view>
    </view>
  </view>

  <!-- 最近赛事 -->
  <view class="section" wx:if="{{recentEvents.length > 0}}">
    <view class="section-title">最近赛事</view>
    <view class="recent-list">
      <view class="recent-item" wx:for="{{recentEvents}}" wx:key="code" bindtap="goTournament">
        <view class="recent-left">
          <text class="recent-name">{{item.name}}</text>
          <text class="recent-date">{{item.eventDate}}</text>
        </view>
        <view class="recent-right">
          <text class="recent-rank">#{{item.rank || '--'}}</text>
          <text class="recent-score">{{item.score > 0 ? '+' : ''}}{{item.score || 0}}</text>
        </view>
      </view>
    </view>
  </view>

  <view style="height:120rpx"></view>
</view>
