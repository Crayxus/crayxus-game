page { background: #0a0e1a; }

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 100%);
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}
.header-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.header-right { display: flex; gap: 12rpx; }
.scan-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  background: rgba(255,255,255,.04);
}
.scan-icon { font-size: 26rpx; color: rgba(255,255,255,.4); }

/* 蛋力值卡片 */
.danli-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(0,212,170,.12) 0%, rgba(124,77,255,.08) 100%);
  border: 1rpx solid rgba(0,212,170,.2);
  border-radius: 20rpx;
}
.danli-left { flex: 1; }
.danli-label { font-size: 22rpx; color: rgba(255,255,255,.5); margin-bottom: 8rpx; }
.danli-score-row { display: flex; align-items: baseline; gap: 4rpx; }
.danli-score { font-size: 64rpx; font-weight: 900; color: #ffd700; }
.danli-max { font-size: 24rpx; color: rgba(255,255,255,.25); }
.danli-rank { font-size: 24rpx; color: #00d4aa; font-weight: 600; margin-top: 4rpx; }
.danli-right { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.danli-test-btn {
  font-size: 20rpx; color: #00d4aa;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(0,212,170,.3);
  border-radius: 20rpx;
}

/* 功能入口 */
.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entry-grid.three-col {
  grid-template-columns: 1fr 1fr 1fr;
}
.entry-card {
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.entry-icon { font-size: 40rpx; }
.entry-name { font-size: 26rpx; font-weight: 700; color: #fff; }
.entry-desc { font-size: 18rpx; color: rgba(255,255,255,.35); text-align: center; }

.entry-danli { border-color: rgba(255,107,107,.15); background: rgba(255,107,107,.04); }
.entry-tournament { border-color: rgba(255,0,255,.15); background: rgba(255,0,255,.04); }
.entry-daily { border-color: rgba(61,157,255,.15); background: rgba(61,157,255,.04); }

/* Section */
.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,.02);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
}

/* 维度列表 */
.dim-list { display: flex; flex-direction: column; gap: 16rpx; }
.dim-row { display: flex; align-items: center; gap: 12rpx; }
.dim-icon { font-size: 28rpx; width: 40rpx; text-align: center; }
.dim-name { font-size: 24rpx; color: rgba(255,255,255,.6); width: 80rpx; }
.dim-bar { flex: 1; height: 12rpx; background: rgba(255,255,255,.06); border-radius: 6rpx; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 6rpx; transition: width .6s ease; }
.dim-val { font-size: 26rpx; font-weight: 700; width: 80rpx; text-align: right; }

/* 统计网格 */
.stat-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12rpx; }
.stat-item { text-align: center; }
.stat-val { display: block; font-size: 36rpx; font-weight: 800; color: #00d4aa; }
.stat-label { display: block; font-size: 20rpx; color: rgba(255,255,255,.35); margin-top: 4rpx; }

/* AI 周赛程 */
.ai-week-row { display: flex; gap: 8rpx; justify-content: space-between; }
.ai-day-mini {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  padding: 10rpx 8rpx; border-radius: 12rpx; flex: 1;
  background: rgba(255,255,255,.02); border: 1rpx solid rgba(255,255,255,.04);
}
.ai-day-mini.today {
  background: rgba(0,212,170,.08); border-color: rgba(0,212,170,.2);
}
.ai-day-label { font-size: 18rpx; color: rgba(255,255,255,.3); }
.ai-day-mini.today .ai-day-label { color: #00d4aa; }
.ai-day-logo { font-size: 28rpx; }
.ai-day-name { font-size: 18rpx; font-weight: 700; }

/* 最近赛事 */
.recent-list { display: flex; flex-direction: column; gap: 12rpx; }
.recent-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(255,255,255,.02); border: 1rpx solid rgba(255,255,255,.04);
}
.recent-left { flex: 1; }
.recent-name { font-size: 24rpx; font-weight: 600; color: #fff; display: block; }
.recent-date { font-size: 20rpx; color: rgba(255,255,255,.3); }
.recent-right { text-align: right; }
.recent-rank { font-size: 28rpx; font-weight: 800; color: #ffd700; display: block; }
.recent-score { font-size: 20rpx; color: #00d4aa; }

/* 蛋力 Token */
.egg-token-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,200,0,0.15), rgba(255,200,0,0.05));
  border: 1rpx solid rgba(255,200,0,0.3);
}
.egg-token-val {
  font-size: 26rpx;
  color: #ffc800;
  font-weight: bold;
}
