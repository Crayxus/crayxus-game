page { background: #0a0e1a; }

.page {
  min-height: 100vh;
  padding: 0 24rpx;
  background: linear-gradient(180deg, #0a0e1a 0%, #0d1220 100%);
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
  gap: 12rpx;
}
.back-arrow {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: rgba(255,255,255,.75);
  font-weight: 600;
}
.header-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}
.header-right { display: flex; gap: 12rpx; }
.scan-btn {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border: 1rpx solid rgba(255,255,255,.1);
  border-radius: 12rpx;
  background: rgba(255,255,255,.04);
}
.scan-icon { font-size: 26rpx; color: rgba(255,255,255,.4); }

/* 蛋力值卡片 */
.danli-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, rgba(0,212,170,.12) 0%, rgba(124,77,255,.08) 100%);
  border: 1rpx solid rgba(0,212,170,.2);
  border-radius: 20rpx;
}
.danli-left { flex: 1; }
.danli-label { font-size: 22rpx; color: rgba(255,255,255,.5); margin-bottom: 8rpx; }
.danli-score-row { display: flex; align-items: baseline; gap: 4rpx; }
.danli-score { font-size: 64rpx; font-weight: 900; color: #ffd700; }
.danli-max { font-size: 24rpx; color: rgba(255,255,255,.25); }
.danli-rank { font-size: 24rpx; color: #00d4aa; font-weight: 600; margin-top: 4rpx; }
.danli-right { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }

/* 等级徽章 — 六边形, 按 tier 变色, 克制不花哨 */
.rank-badge {
  position: relative;
  width: 120rpx;
  height: 136rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
  flex-shrink: 0;
}
.rank-badge-hex {
  position: absolute;
  inset: 0;
  clip-path: polygon(50% 2%, 96% 26%, 96% 74%, 50% 98%, 4% 74%, 4% 26%);
}
.rank-badge-outer {
  background: linear-gradient(135deg, var(--tier-hi, #8b95a8) 0%, var(--tier-lo, #3d4556) 100%);
  filter: drop-shadow(0 4rpx 10rpx var(--tier-glow, rgba(139,149,168,0.35)));
}
.rank-badge-inner {
  inset: 4rpx;
  background: linear-gradient(160deg, #1a1f2e 0%, #0a0e18 100%);
  clip-path: polygon(50% 2%, 96% 26%, 96% 74%, 50% 98%, 4% 74%, 4% 26%);
}
.rank-badge-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  line-height: 1;
}
.rank-badge-tier {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--tier-hi, #c7cfdb);
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5);
}
.rank-badge-sub {
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(255,255,255,0.5);
  letter-spacing: 1rpx;
}
/* tier 配色 */
.tier-bronze { --tier-hi: #e6a86b; --tier-lo: #7a4a1f; --tier-glow: rgba(205,127,50,0.35); }
.tier-silver { --tier-hi: #dce4f0; --tier-lo: #5d6578; --tier-glow: rgba(192,202,220,0.3); }
.tier-gold { --tier-hi: #ffe066; --tier-lo: #b88a1a; --tier-glow: rgba(255,215,0,0.4); }
.tier-platinum { --tier-hi: #7eecff; --tier-lo: #0e8aa8; --tier-glow: rgba(0,229,255,0.4); }
.tier-diamond { --tier-hi: #d4b3ff; --tier-lo: #6436b8; --tier-glow: rgba(179,136,255,0.4); }
.tier-king { --tier-hi: #ff6b6b; --tier-lo: #8b1a1a; --tier-glow: rgba(255,80,80,0.4); }
.danli-test-btn {
  font-size: 20rpx; color: #00d4aa;
  padding: 6rpx 16rpx;
  border: 1rpx solid rgba(0,212,170,.3);
  border-radius: 20rpx;
}

/* 功能入口 */
.entry-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.entry-grid.three-col {
  grid-template-columns: 1fr 1fr 1fr;
}
.entry-card {
  padding: 28rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.03);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.entry-icon { font-size: 40rpx; }
.entry-name { font-size: 26rpx; font-weight: 700; color: #fff; }
.entry-desc { font-size: 18rpx; color: rgba(255,255,255,.35); text-align: center; }

.entry-danli { border-color: rgba(255,107,107,.15); background: rgba(255,107,107,.04); }
.entry-tournament { border-color: rgba(255,0,255,.15); background: rgba(255,0,255,.04); }
.entry-daily { border-color: rgba(61,157,255,.15); background: rgba(61,157,255,.04); }

/* Section */
.section {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: rgba(255,255,255,.02);
  border: 1rpx solid rgba(255,255,255,.06);
  border-radius: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 20rpx;
}

/* 维度列表 */
.dim-list { display: flex; flex-direction: column; gap: 16rpx; }
.dim-row { display: flex; align-items: center; gap: 12rpx; }
.dim-icon { font-size: 28rpx; width: 40rpx; text-align: center; }
.dim-name { font-size: 24rpx; color: rgba(255,255,255,.6); width: 80rpx; }
.dim-bar { flex: 1; height: 12rpx; background: rgba(255,255,255,.06); border-radius: 6rpx; overflow: hidden; }
.dim-fill { height: 100%; border-radius: 6rpx; transition: width .6s ease; }
.dim-val { font-size: 26rpx; font-weight: 700; width: 80rpx; text-align: right; }

/* 统计网格 */
.stat-grid { display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 12rpx; }
.stat-item { text-align: center; }
.stat-val { display: block; font-size: 36rpx; font-weight: 800; color: #00d4aa; }
.stat-label { display: block; font-size: 20rpx; color: rgba(255,255,255,.35); margin-top: 4rpx; }

/* AI 周赛程 */
.ai-week-row { display: flex; gap: 8rpx; justify-content: space-between; }
.ai-day-mini {
  display: flex; flex-direction: column; align-items: center; gap: 4rpx;
  padding: 10rpx 8rpx; border-radius: 12rpx; flex: 1;
  background: rgba(255,255,255,.02); border: 1rpx solid rgba(255,255,255,.04);
}
.ai-day-mini.today {
  background: rgba(0,212,170,.08); border-color: rgba(0,212,170,.2);
}
.ai-day-label { font-size: 18rpx; color: rgba(255,255,255,.3); }
.ai-day-mini.today .ai-day-label { color: #00d4aa; }
.ai-day-logo { font-size: 28rpx; }
.ai-day-name { font-size: 18rpx; font-weight: 700; }

/* 最近赛事 */
.recent-list { display: flex; flex-direction: column; gap: 12rpx; }
.recent-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 20rpx; border-radius: 12rpx;
  background: rgba(255,255,255,.02); border: 1rpx solid rgba(255,255,255,.04);
}
.recent-left { flex: 1; }
.recent-name { font-size: 24rpx; font-weight: 600; color: #fff; display: block; }
.recent-date { font-size: 20rpx; color: rgba(255,255,255,.3); }
.recent-right { text-align: right; }
.recent-rank { font-size: 28rpx; font-weight: 800; color: #ffd700; display: block; }
.recent-score { font-size: 20rpx; color: #00d4aa; }

/* 蛋力 Token */
.egg-token-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, rgba(255,200,0,0.15), rgba(255,200,0,0.05));
  border: 1rpx solid rgba(255,200,0,0.3);
}
.egg-token-val {
  font-size: 26rpx;
  color: #ffc800;
  font-weight: bold;
}

/* 5列入口 */
.five-col { grid-template-columns: repeat(5, 1fr) !important; }
.entry-academy .entry-icon { background: linear-gradient(135deg, #ffc800, #ff9800) !important; }
.entry-shop .entry-icon { background: linear-gradient(135deg, #4dd0e1, #00bcd4) !important; }

/* 学习进度 */
.progress-grid { display: flex; flex-direction: column; gap: 16rpx; }
.progress-item { display: flex; align-items: center; gap: 16rpx; }
.progress-icon { font-size: 28rpx; width: 40rpx; text-align: center; }
.progress-info { flex: 1; }
.progress-name { font-size: 24rpx; color: #e0e0e0; display: block; margin-bottom: 6rpx; }
.progress-bar-bg { height: 12rpx; background: #1e3148; border-radius: 6rpx; overflow: hidden; }
.progress-bar-fill { height: 100%; border-radius: 6rpx; transition: width 0.3s; }
.progress-pct { font-size: 22rpx; font-weight: bold; min-width: 60rpx; text-align: right; }

/* 学习进度横排 */
.progress-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.progress-chip { display: flex; align-items: center; gap: 6rpx; flex: 1; min-width: 140rpx; }
.chip-icon { font-size: 24rpx; }
.chip-bar-bg { flex: 1; height: 10rpx; background: #1e3148; border-radius: 5rpx; overflow: hidden; }
.chip-bar-fill { height: 100%; border-radius: 5rpx; }

/* 蛋力余额条 */
.egg-bar {
  display: flex; align-items: center; gap: 12rpx;
  padding: 14rpx 24rpx; margin: 16rpx 0;
  background: linear-gradient(135deg, rgba(255,200,0,0.12), rgba(255,200,0,0.04));
  border: 1rpx solid rgba(255,200,0,0.25);
  border-radius: 20rpx;
}
.egg-bar-val { font-size: 28rpx; color: #ffc800; font-weight: bold; flex: 1; }
.egg-bar-add {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(255,200,0,0.2); color: #ffc800;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; font-weight: bold;
}

/* 学习进度 两行三列 */
.learn-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.learn-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 12rpx 16rpx; background: #1e3148; border-radius: 12rpx;
}
.learn-icon { font-size: 26rpx; }
.learn-name { font-size: 24rpx; color: #e0e0e0; flex: 1; }
.learn-pct { font-size: 22rpx; font-weight: bold; }

/* 蛋力条新样式 */
.egg-bar-info { flex: 1; }
.egg-row { display: flex; align-items: center; gap: 8rpx; }
.egg-label { font-size: 22rpx; color: #ffc800; }
.egg-score-val { font-size: 24rpx; color: #a0b0c0; }
.egg-bar-more { font-size: 22rpx; color: #8899aa; }

/* 联系我们 */
.contact-section {
  text-align: center; padding: 30rpx; margin-top: 20rpx;
  border-top: 1rpx solid #1e3148;
}
.contact-label { font-size: 22rpx; color: #8899aa; display: block; margin-bottom: 8rpx; }
.contact-email { font-size: 24rpx; color: #58cc02; }

/* AI 实验室 */
.ai-lab {
  margin-bottom: 24rpx;
  padding: 20rpx 20rpx 24rpx;
  background: linear-gradient(135deg, rgba(255,0,128,.05) 0%, rgba(0,212,255,.05) 50%, rgba(0,212,170,.05) 100%);
  border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}
.ai-lab-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.ai-lab-tag {
  font-size: 20rpx;
  letter-spacing: 3rpx;
  color: #00d4ff;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(0,212,255,.3);
  border-radius: 4rpx;
}
.ai-lab-sub {
  font-size: 20rpx;
  color: #ffd700;
  font-weight: 600;
}
.ai-lab-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.lab-card {
  position: relative;
  padding: 22rpx 20rpx 20rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(255,255,255,.1);
  background: rgba(0,0,0,.35);
  overflow: hidden;
  min-height: 240rpx;
}
.lab-glow {
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 220rpx; height: 220rpx;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(10rpx);
}
.lab-glow-racing { background: radial-gradient(circle, rgba(255,0,128,.5), transparent 70%); }
.lab-glow-boost  { background: radial-gradient(circle, rgba(0,212,170,.5), transparent 70%); }
.lab-racing { border-color: rgba(255,0,128,.35); }
.lab-boost  { border-color: rgba(0,212,170,.35); }
.lab-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 6rpx; }
.lab-emoji { font-size: 48rpx; }
.lab-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 1rpx;
}
.lab-racing .lab-title {
  background: linear-gradient(90deg, #fff, #ff0080);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lab-boost .lab-title {
  background: linear-gradient(90deg, #fff, #00d4aa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.lab-sub { font-size: 20rpx; color: rgba(255,255,255,.55); }
.lab-chips { display: flex; gap: 6rpx; margin-top: 10rpx; flex-wrap: wrap; }
.lab-chip {
  font-size: 18rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,.06);
  color: rgba(255,255,255,.7);
  border: 1rpx solid rgba(255,255,255,.08);
}
.lab-cta {
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 700;
}
.lab-racing .lab-cta { color: #ff0080; }
.lab-boost .lab-cta { color: #00d4aa; }

/* 亮色主题 */
.page.light { background: linear-gradient(180deg, #f0f2f5, #e8ecf0) !important; }
.page.light .header-title { color: #1a1a2e !important; }
.page.light .section-title { color: #1a1a2e !important; }
.page.light .danli-card { background: #fff !important; border-color: rgba(0,0,0,0.08) !important; }
.page.light .entry-card { background: #fff !important; border-color: rgba(0,0,0,0.08) !important; }
.page.light .section { background: #fff !important; }
.page.light .learn-item { background: #f0f2f5 !important; }
.page.light .learn-name { color: #1a1a2e !important; }
.page.light .stat-grid { background: #fff !important; }
