page {
  background: #050810;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", sans-serif;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding: 0 24rpx 60rpx;
  background:
    radial-gradient(ellipse at top right, rgba(255,107,53,.16), transparent 55%),
    radial-gradient(ellipse at bottom left, rgba(0,212,255,.10), transparent 60%),
    linear-gradient(180deg, #050810 0%, #0a1224 50%, #050810 100%);
}

/* 浮动返回 */
.float-back {
  position: fixed;
  left: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 18rpx 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255,107,53,.22);
  border: 1rpx solid rgba(255,215,0,.45);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,.4);
}
.float-back:active { transform: scale(0.96); }
.fb-arrow { font-size: 28rpx; color: #ffd700; font-weight: 700; line-height: 1; }
.fb-text { font-size: 20rpx; color: #fff; font-weight: 600; letter-spacing: 1rpx; line-height: 1; }

/* 品牌头 */
.brand-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 18rpx 200rpx 24rpx 160rpx;
}
.brand-left { display: flex; align-items: center; gap: 12rpx; }
.brand-logo {
  width: 52rpx; height: 52rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #ff6b35, #c1121c);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  line-height: 52rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 14rpx rgba(255,107,53,.5);
}
.brand-text { display: flex; flex-direction: column; min-width: 0; }
.brand-cn { font-size: 22rpx; color: #fff; font-weight: 700; letter-spacing: 1rpx; white-space: nowrap; }
.brand-en { font-size: 14rpx; color: rgba(255,255,255,.5); letter-spacing: 2rpx; white-space: nowrap; }

/* Hero */
.hero {
  position: relative;
  margin-bottom: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(135deg, rgba(255,107,53,.18), rgba(255,215,0,.04)),
    rgba(10,18,36,.8);
  border: 1rpx solid rgba(255,107,53,.35);
  overflow: hidden;
}
.hero-deco {
  position: absolute;
  top: -120rpx; right: -120rpx;
  width: 360rpx; height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,107,53,.32), transparent 70%);
}
.hero-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255,107,53,.18);
  border: 1rpx solid rgba(255,107,53,.4);
  color: #ffba8c;
  font-size: 18rpx;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.2;
  margin-bottom: 14rpx;
}
.ht-accent {
  background: linear-gradient(90deg, #ff6b35, #ffd700);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.hero-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,.6);
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,.08);
}
.stat { display: flex; flex-direction: column; align-items: center; flex: 1; }
.stat-num {
  font-size: 32rpx;
  font-weight: 800;
  color: #ff6b35;
  line-height: 1;
}
.stat-unit { font-size: 18rpx; color: rgba(255,255,255,.5); margin-left: 4rpx; }
.stat-lbl { font-size: 18rpx; color: rgba(255,255,255,.45); margin-top: 8rpx; letter-spacing: 1rpx; }
.stat-sep { width: 1rpx; height: 50rpx; background: rgba(255,255,255,.1); }

/* ==================== 主菜单视图 ==================== */
.menu-intro {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  margin: 60rpx 0 50rpx;
}
.mi-tag {
  font-size: 22rpx;
  color: rgba(255,255,255,.5);
  letter-spacing: 6rpx;
  font-weight: 600;
}
.mi-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 0 8rpx;
}

.menu-card {
  position: relative;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(15,28,52,.85), rgba(10,18,36,.95));
  border: 2rpx solid rgba(255,255,255,.08);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.4);
  transition: transform 0.2s ease, border-color 0.2s ease;
}
.menu-card:active {
  transform: scale(0.98);
  border-color: rgba(255,255,255,.2);
}
.mc-bg-glow {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.4;
  pointer-events: none;
}
.hw-glow { background: radial-gradient(circle, #ff6b35, transparent 70%); }
.model-glow { background: radial-gradient(circle, #e91e63, transparent 70%); }
.sw-glow { background: radial-gradient(circle, #7c4dff, transparent 70%); }

.hw-card { border-color: rgba(255,107,53,.3); }
.model-card { border-color: rgba(233,30,99,.3); }
.sw-card { border-color: rgba(124,77,255,.3); }

.mc-icon-box {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,.06);
  border: 1rpx solid rgba(255,255,255,.12);
  z-index: 2;
}
.mc-icon { font-size: 80rpx; line-height: 1; }

.mc-body {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  z-index: 2;
}
.mc-title { font-size: 38rpx; color: #fff; font-weight: 800; letter-spacing: 1rpx; }
.mc-sub { font-size: 22rpx; color: rgba(255,255,255,.55); letter-spacing: 0.5rpx; }

.mc-stats {
  position: relative;
  display: flex;
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(255,255,255,.08);
  border-bottom: 1rpx solid rgba(255,255,255,.08);
  z-index: 2;
}
.mcs-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.mcs-cell + .mcs-cell { border-left: 1rpx solid rgba(255,255,255,.08); }
.mcs-num { font-size: 32rpx; font-weight: 800; color: #fff; line-height: 1; }
.mcs-unit { font-size: 20rpx; color: rgba(255,255,255,.5); margin-left: 2rpx; font-weight: 600; }
.mcs-lbl { font-size: 18rpx; color: rgba(255,255,255,.45); letter-spacing: 1rpx; }

.mc-arrow {
  position: relative;
  text-align: center;
  z-index: 2;
}
.mc-arrow text {
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
  font-weight: 700;
  letter-spacing: 2rpx;
}
.hw-card .mc-arrow text { color: #ff6b35; }
.model-card .mc-arrow text { color: #ff5e8a; }
.sw-card .mc-arrow text { color: #a587ff; }

.menu-footer {
  margin-top: 50rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  text-align: center;
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08);
}
.mf-line {
  font-size: 20rpx;
  color: rgba(255,255,255,.6);
  letter-spacing: 0.5rpx;
}

/* ==================== 板块视图 (drilled) ==================== */
.cat-banner {
  margin: 0 0 26rpx;
  padding: 28rpx 26rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(255,255,255,.1);
}
.cb-icon {
  width: 88rpx; height: 88rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,.1);
  border: 1rpx solid rgba(255,255,255,.18);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}
.cb-text { display: flex; flex-direction: column; gap: 6rpx; flex: 1; }
.cb-title { font-size: 32rpx; color: #fff; font-weight: 800; letter-spacing: 1rpx; }
.cb-sub { font-size: 22rpx; color: rgba(255,255,255,.65); }

.back-to-menu {
  margin: 32rpx auto 8rpx;
  padding: 18rpx 36rpx;
  border-radius: 999rpx;
  background: rgba(255,107,53,.18);
  border: 1rpx solid rgba(255,107,53,.4);
  text-align: center;
  width: fit-content;
}
.back-to-menu:active { background: rgba(255,107,53,.28); transform: scale(0.96); }
.back-to-menu text {
  font-size: 24rpx;
  color: #ffba8c;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 板块 (legacy class - kept for safety) */
.section {
  margin-top: 36rpx;
  margin-bottom: 12rpx;
}
.section-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 4rpx 20rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.08);
  margin-bottom: 22rpx;
}
.sh-icon { font-size: 44rpx; line-height: 1; flex-shrink: 0; }
.sh-text { display: flex; flex-direction: column; gap: 4rpx; flex: 1; }
.sh-title { font-size: 30rpx; color: #fff; font-weight: 800; letter-spacing: 1rpx; }
.sh-sub { font-size: 20rpx; color: rgba(255,255,255,.5); letter-spacing: 0.5rpx; }
.sh-count {
  flex-shrink: 0;
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  background: rgba(255,107,53,.2);
  border: 1rpx solid rgba(255,107,53,.45);
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  color: #ffba8c;
  font-weight: 800;
}

/* 学术后援卡 */
.academic-card {
  margin-bottom: 32rpx;
  padding: 26rpx 24rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(255,107,53,.08), rgba(124,77,255,.08));
  border: 1rpx solid rgba(255,107,53,.3);
}
.ac-title-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 18rpx; }
.ac-icon { font-size: 36rpx; line-height: 1; }
.ac-title { font-size: 26rpx; color: #fff; font-weight: 800; letter-spacing: 1rpx; }
.ac-lead {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
  background: rgba(255,107,53,.14);
  border-radius: 12rpx;
  border-left: 3rpx solid #ff6b35;
}
.ac-lead-tag {
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #ff6b35, #c1121c);
  font-size: 18rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.ac-lead-text { font-size: 22rpx; color: rgba(255,255,255,.85); line-height: 1.5; flex: 1; }
.ac-hl { color: #ffd700; font-weight: 800; }
.ac-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-bottom: 16rpx;
}
.ac-cell {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08);
}
.ac-flag { font-size: 28rpx; line-height: 1; flex-shrink: 0; }
.ac-info { display: flex; flex-direction: column; gap: 2rpx; flex: 1; min-width: 0; }
.ac-name { font-size: 22rpx; color: #fff; font-weight: 700; letter-spacing: 0.5rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ac-role { font-size: 16rpx; color: rgba(255,255,255,.5); letter-spacing: 0.5rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ac-footer {
  text-align: center;
  padding-top: 8rpx;
}
.ac-footer text { font-size: 20rpx; color: rgba(255,255,255,.6); letter-spacing: 0.5rpx; }

/* 项目卡片 - 海报式大 banner */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.project-card {
  position: relative;
  border-radius: 24rpx;
  background: rgba(15,28,52,.7);
  border: 1rpx solid rgba(255,255,255,.08);
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,.25);
}
.project-card:active { transform: scale(0.99); }

.pc-banner {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}
.pc-banner-img {
  width: 100%;
  height: 100%;
  display: block;
}
.pc-banner-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to bottom, transparent, rgba(15,28,52,.85));
  pointer-events: none;
}
.pc-mega-icon {
  font-size: 160rpx;
  line-height: 1;
  filter: drop-shadow(0 8rpx 20rpx rgba(0,0,0,.5));
}
.pc-cat-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,.4);
  border: 1rpx solid rgba(255,255,255,.18);
  backdrop-filter: blur(10rpx);
  font-size: 18rpx;
  color: rgba(255,255,255,.85);
  letter-spacing: 1rpx;
  z-index: 3;
}

.pc-content {
  padding: 22rpx 22rpx 20rpx;
}
.pc-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}
.pc-name { font-size: 32rpx; color: #fff; font-weight: 800; letter-spacing: 0.5rpx; flex: 1; }
.pc-short { font-size: 22rpx; color: rgba(255,255,255,.55); margin-bottom: 18rpx; display: block; }

.pc-stats {
  display: flex;
  margin-bottom: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid rgba(255,255,255,.06);
  border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.pc-stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.pcs-num {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}
.pcs-num.joined { font-size: 26rpx; }
.pcs-unit { font-size: 18rpx; color: rgba(255,255,255,.5); margin-left: 2rpx; font-weight: 600; }
.pcs-lbl { font-size: 18rpx; color: rgba(255,255,255,.45); letter-spacing: 1rpx; margin-top: 6rpx; }

.pc-progress-wrap {
  width: 100%;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}
.pc-progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 14rpx currentColor;
}

.pc-arrow {
  font-size: 36rpx;
  font-weight: 700;
  flex-shrink: 0;
  letter-spacing: 1rpx;
  margin-left: 14rpx;
}

/* 联系卡 + footer */
.contact-card {
  margin-top: 48rpx;
  padding: 28rpx 26rpx;
  border-radius: 20rpx;
  background: rgba(15,28,52,.7);
  border: 1rpx solid rgba(255,255,255,.1);
}
.cc-row { display: flex; justify-content: space-between; padding: 12rpx 0; }
.cc-lbl { font-size: 22rpx; color: rgba(255,255,255,.45); letter-spacing: 1rpx; }
.cc-val { font-size: 22rpx; color: #fff; }

.footer-mark {
  margin-top: 36rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,.45);
  letter-spacing: 4rpx;
}
.footer-mark .fm-sub { font-size: 18rpx; color: rgba(255,255,255,.3); letter-spacing: 2rpx; }

/* 详情 overlay */
.detail-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 999;
}
.do-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,.75);
}
.do-sheet {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  max-height: 90vh;
  background: linear-gradient(180deg, #0a1224 0%, #050810 100%);
  border-radius: 28rpx 28rpx 0 0;
  border-top: 1rpx solid rgba(255,107,53,.4);
  display: flex;
  flex-direction: column;
}
.do-handle {
  width: 80rpx;
  height: 6rpx;
  background: rgba(255,255,255,.2);
  border-radius: 3rpx;
  margin: 14rpx auto 0;
}
.do-scroll {
  padding: 0 28rpx;
  flex: 1;
  max-height: 86vh;
}
.do-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 18rpx -28rpx 18rpx;
  padding: 24rpx 28rpx 20rpx;
}
.do-icon {
  width: 80rpx; height: 80rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.4);
}
.do-title-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.do-name { font-size: 32rpx; color: #fff; font-weight: 800; letter-spacing: 1rpx; }
.do-cat-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255,255,255,.08);
  font-size: 18rpx;
  color: rgba(255,255,255,.7);
  letter-spacing: 1rpx;
  align-self: flex-start;
}
.do-close {
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: rgba(255,255,255,.08);
  text-align: center;
  line-height: 60rpx;
  color: rgba(255,255,255,.6);
  font-size: 28rpx;
  flex-shrink: 0;
}

.do-tagline {
  padding: 14rpx 18rpx;
  margin-bottom: 24rpx;
  background: rgba(255,255,255,.04);
  border-left: 3rpx solid #ff6b35;
  border-radius: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  color: rgba(255,255,255,.85);
  line-height: 1.6;
  letter-spacing: 0.5rpx;
}

/* KPI */
.do-kpi {
  display: flex;
  margin-bottom: 14rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: rgba(255,255,255,.04);
}
.dk-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.dk-cell + .dk-cell { border-left: 1rpx solid rgba(255,255,255,.08); }
.dk-num { font-size: 32rpx; font-weight: 800; line-height: 1; }
.dk-unit { font-size: 18rpx; color: rgba(255,255,255,.5); margin-left: 2rpx; }
.dk-lbl { font-size: 18rpx; color: rgba(255,255,255,.45); letter-spacing: 1rpx; }

.do-progress-big {
  width: 100%;
  height: 10rpx;
  border-radius: 5rpx;
  background: rgba(255,255,255,.08);
  overflow: hidden;
  margin-bottom: 28rpx;
}
.dpb-fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 0.6s ease;
  box-shadow: 0 0 16rpx currentColor;
}

/* 详情 block */
.do-block {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08);
}
.db-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 14rpx;
  letter-spacing: 1rpx;
}
.db-text {
  font-size: 24rpx;
  color: rgba(255,255,255,.78);
  line-height: 1.7;
}

/* 加入收益（高亮 block） */
.do-block.highlight {
  background: linear-gradient(135deg, rgba(255,107,53,.1), rgba(255,215,0,.04));
  border-color: rgba(255,107,53,.35);
}
.benefit-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.benefit-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 14rpx;
  background: rgba(255,255,255,.04);
  border-radius: 12rpx;
}
.bf-icon {
  width: 60rpx; height: 60rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.3);
}
.bf-text { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }
.bf-title {
  font-size: 24rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}
.bf-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,.65);
  line-height: 1.5;
}

/* 团队岗位 */
.role-list { display: flex; flex-direction: column; gap: 10rpx; }
.role-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 14rpx;
  background: rgba(255,255,255,.03);
  border-radius: 10rpx;
}
.rr-name { font-size: 24rpx; color: rgba(255,255,255,.78); }
.rr-num { font-size: 24rpx; font-weight: 800; }

/* 里程碑 */
.ms-list { display: flex; flex-direction: column; gap: 14rpx; }
.ms-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.ms-dot {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 10rpx currentColor;
}
.ms-time {
  width: 130rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,.55);
  font-weight: 600;
  letter-spacing: 1rpx;
  flex-shrink: 0;
}
.ms-text { flex: 1; font-size: 22rpx; color: rgba(255,255,255,.78); line-height: 1.5; }

/* 资金分配 */
.spend-list { display: flex; flex-direction: column; gap: 12rpx; }
.spend-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sr-label {
  width: 200rpx;
  font-size: 22rpx;
  color: rgba(255,255,255,.7);
  flex-shrink: 0;
}
.sr-bar-wrap {
  flex: 1;
  height: 14rpx;
  border-radius: 7rpx;
  background: rgba(255,255,255,.08);
  overflow: hidden;
}
.sr-bar-fill {
  height: 100%;
  border-radius: 7rpx;
  box-shadow: 0 0 10rpx currentColor;
}
.sr-pct {
  width: 60rpx;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
  flex-shrink: 0;
}

/* 行动 */
.do-actions {
  display: flex;
  gap: 14rpx;
  padding: 24rpx 0 16rpx;
}
.da-apply {
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  text-align: center;
  line-height: 88rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(255,107,53,.45);
}
.da-apply:active { transform: scale(0.97); }
.da-apply text { font-size: 26rpx; color: #fff; font-weight: 800; }
.da-close {
  width: 180rpx;
  height: 88rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,.08);
  text-align: center;
  line-height: 88rpx;
}
.da-close text { font-size: 24rpx; color: rgba(255,255,255,.7); }
