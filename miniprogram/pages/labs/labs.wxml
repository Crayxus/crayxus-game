<!-- Crayxus Labs · AI 课外项目实践 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- 浮动返回 -->
  <view class="float-back" style="top:{{statusBarHeight + 12}}px" bindtap="goBack">
    <text class="fb-arrow">←</text>
    <text class="fb-text">{{view === 'menu' ? '返回' : '主菜单'}}</text>
  </view>

  <!-- 顶部品牌头 -->
  <view class="brand-bar">
    <view class="brand-left">
      <view class="brand-logo">🚀</view>
      <view class="brand-text">
        <text class="brand-cn">Crayxus Labs</text>
        <text class="brand-en">AI 课外项目实践</text>
      </view>
    </view>
  </view>

  <!-- ============ 主菜单视图（仅 3 个板块） ============ -->
  <block wx:if="{{view === 'menu'}}">

    <view class="menu-intro">
      <text class="mi-tag">CHOOSE YOUR PATH</text>
      <text class="mi-title">选择你想加入的方向</text>
    </view>

    <view class="menu-grid">

      <!-- 软硬件综合 -->
      <view class="menu-card hw-card" bindtap="enterCategory" data-cat="hw">
        <view class="mc-bg-glow hw-glow"></view>
        <view class="mc-icon-box">
          <text class="mc-icon">🛠</text>
        </view>
        <view class="mc-body">
          <text class="mc-title">软硬件综合</text>
          <text class="mc-sub">实体产品 · AI 大脑</text>
        </view>
        <view class="mc-stats">
          <view class="mcs-cell">
            <text class="mcs-num">{{hwStats.count}}</text>
            <text class="mcs-lbl">项目</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{hwStats.budget}}<text class="mcs-unit">w</text></text>
            <text class="mcs-lbl">总目标</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{hwStats.fillPct}}<text class="mcs-unit">%</text></text>
            <text class="mcs-lbl">已招</text>
          </view>
        </view>
        <view class="mc-arrow"><text>查看 {{hwStats.count}} 个项目 →</text></view>
      </view>

      <!-- 大模型开发 -->
      <view class="menu-card model-card" bindtap="enterCategory" data-cat="model">
        <view class="mc-bg-glow model-glow"></view>
        <view class="mc-icon-box">
          <text class="mc-icon">🧠</text>
        </view>
        <view class="mc-body">
          <text class="mc-title">AI 大模型开发</text>
          <text class="mc-sub">博弈 · 多智能体 · V8 框架</text>
        </view>
        <view class="mc-stats">
          <view class="mcs-cell">
            <text class="mcs-num">{{modelStats.count}}</text>
            <text class="mcs-lbl">项目</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{modelStats.budget}}<text class="mcs-unit">w</text></text>
            <text class="mcs-lbl">总目标</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{modelStats.fillPct}}<text class="mcs-unit">%</text></text>
            <text class="mcs-lbl">已招</text>
          </view>
        </view>
        <view class="mc-arrow"><text>查看 {{modelStats.count}} 个项目 →</text></view>
      </view>

      <!-- AAAS 项目 -->
      <view class="menu-card sw-card" bindtap="enterCategory" data-cat="sw">
        <view class="mc-bg-glow sw-glow"></view>
        <view class="mc-icon-box">
          <text class="mc-icon">💻</text>
        </view>
        <view class="mc-body">
          <text class="mc-title">AAAS 项目</text>
          <text class="mc-sub">真实客户落地 · AAAS</text>
        </view>
        <view class="mc-stats">
          <view class="mcs-cell">
            <text class="mcs-num">{{swStats.count}}</text>
            <text class="mcs-lbl">项目</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{swStats.budget}}<text class="mcs-unit">w</text></text>
            <text class="mcs-lbl">总目标</text>
          </view>
          <view class="mcs-cell">
            <text class="mcs-num">{{swStats.fillPct}}<text class="mcs-unit">%</text></text>
            <text class="mcs-lbl">已招</text>
          </view>
        </view>
        <view class="mc-arrow"><text>查看 {{swStats.count}} 个项目 →</text></view>
      </view>

    </view>

    <view class="menu-footer">
      <text class="mf-line">浙江大学 · 张旭光教授 主导 · 海外名校学术顾问网络对接中</text>
    </view>

    <view class="market-note">
      <text class="mn-icon">📊</text>
      <view class="mn-body">
        <text class="mn-title">满席启动 · 市场决定项目</text>
        <text class="mn-desc">每个项目独立众筹 · 该项目认领满席后启动 · 不强求所有项目同时开工</text>
      </view>
    </view>

    <view class="legal-note">
      <text>* 本平台所述"营收分润权 / NFT 凭证 / 优先购买权"为基于具体项目协议的合同权益，不构成证券产品。最终条款以正式认领协议为准。本平台不承诺保本收益，赞助前请确认风险承受能力。</text>
    </view>
  </block>

  <!-- ============ 板块视图（点击板块后） ============ -->
  <block wx:if="{{view !== 'menu'}}">

    <view class="cat-banner" style="background:linear-gradient(135deg, {{activeColor}}33, rgba(0,0,0,.4))">
      <view class="cb-icon">{{activeIcon}}</view>
      <view class="cb-text">
        <text class="cb-title">{{activeTitle}}</text>
        <text class="cb-sub">{{activeProjects.length}} 个项目 · 创始席位招募中</text>
      </view>
    </view>

    <view class="project-list">
      <view class="project-card" wx:for="{{activeProjects}}" wx:key="key" bindtap="openDetail" data-key="{{item.key}}">
        <view class="pc-banner">
          <image wx:if="{{item.image}}" class="pc-banner-img" src="{{item.image}}" mode="aspectFill"></image>
          <view wx:else class="pc-banner-fallback" style="background:radial-gradient(circle at 30% 30%, {{item.color}}55, transparent 60%), linear-gradient(135deg, {{item.color}}22, rgba(0,0,0,.4))">
            <text class="pc-mega-icon">{{item.icon}}</text>
          </view>
          <view wx:if="{{item.image}}" class="pc-banner-overlay"></view>
          <text class="pc-cat-badge">{{view === 'hw' ? '软硬件' : (view === 'model' ? '大模型' : 'AAAS')}}</text>
        </view>
        <view class="pc-content">
          <view class="pc-name-row">
            <text class="pc-name">{{item.name}}</text>
            <text class="pc-arrow" style="color:{{item.color}}">→</text>
          </view>
          <text class="pc-short">{{item.short}}</text>
          <view class="pc-stats">
            <view class="pc-stat-cell">
              <text class="pcs-num" style="color:{{item.color}}">{{item.perSeat}}<text class="pcs-unit">{{item.seatUnit}}/席</text></text>
              <text class="pcs-lbl">单席价</text>
            </view>
            <view class="pc-stat-cell">
              <text class="pcs-num">{{item.duration === 999 ? '持续' : item.duration + 'm'}}</text>
              <text class="pcs-lbl">周期</text>
            </view>
            <view class="pc-stat-cell">
              <text class="pcs-num">{{item.joined}}/{{item.seats}}</text>
              <text class="pcs-lbl">名额</text>
            </view>
          </view>
          <view class="pc-progress-wrap">
            <view class="pc-progress-fill" style="width:{{(item.joined / item.seats * 100)}}%; background:{{item.color}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="back-to-menu" bindtap="backToMenu">
      <text>← 返回主菜单</text>
    </view>
  </block>

  <view style="height:60rpx"></view>

  <!-- 项目详情 overlay -->
  <view class="detail-overlay" wx:if="{{detailOpen}}" catchtouchmove="_noop">
    <view class="do-mask" bindtap="closeDetail"></view>
    <view class="do-sheet">
      <view class="do-handle"></view>
      <scroll-view class="do-scroll" scroll-y="true">
        <view class="do-head" style="background:linear-gradient(135deg, {{currentProject.color}}26, transparent)">
          <view class="do-icon" style="background:linear-gradient(135deg, {{currentProject.color}}, rgba(0,0,0,.4))">
            <text>{{currentProject.icon}}</text>
          </view>
          <view class="do-title-block">
            <text class="do-name">{{currentProject.name}}</text>
            <text class="do-cat-tag">{{currentProject.cat === 'hw' ? '🛠 软硬件一体项目' : (currentProject.cat === 'model' ? '🧠 AI 大模型开发' : '💻 AAAS 开发项目')}}</text>
          </view>
          <text class="do-close" bindtap="closeDetail">✕</text>
        </view>

        <view class="do-tagline">{{currentProject.tagline}}</view>

        <view class="do-kpi">
          <view class="dk-cell">
            <text class="dk-num" style="color:{{currentProject.color}}">{{currentProject.perSeat}}<text class="dk-unit">{{currentProject.seatUnit}}</text></text>
            <text class="dk-lbl">单席价</text>
          </view>
          <view class="dk-cell">
            <text class="dk-num" style="color:{{currentProject.color}}">{{currentProject.budget}}<text class="dk-unit">w</text></text>
            <text class="dk-lbl">总预算</text>
          </view>
          <view class="dk-cell">
            <text class="dk-num" style="color:{{currentProject.color}}">{{currentProject.duration === 999 ? '持续' : currentProject.duration + 'm'}}</text>
            <text class="dk-lbl">周期</text>
          </view>
          <view class="dk-cell">
            <text class="dk-num" style="color:{{currentProject.color}}">{{currentProject.joined}}/{{currentProject.seats}}</text>
            <text class="dk-lbl">名额</text>
          </view>
        </view>

        <view class="do-progress-big">
          <view class="dpb-fill" style="width:{{currentProject.progress}}%; background:{{currentProject.color}}"></view>
        </view>

        <view class="do-block">
          <view class="db-title">🎯 项目痛点</view>
          <view class="db-text">{{currentProject.painpoint}}</view>
        </view>

        <view class="do-block">
          <view class="db-title">⚙️ 技术架构</view>
          <view class="db-text">{{currentProject.tech}}</view>
        </view>

        <view class="do-block highlight">
          <view class="db-title">🎁 加入这个项目你能得到什么</view>
          <view class="benefit-list">
            <view class="benefit-row" wx:for="{{currentProject.benefits}}" wx:key="t" wx:for-item="bf">
              <view class="bf-icon" style="background:linear-gradient(135deg, {{currentProject.color}}, rgba(0,0,0,.4))">
                <text>{{bf.icon}}</text>
              </view>
              <view class="bf-text">
                <text class="bf-title">{{bf.t}}</text>
                <text class="bf-desc">{{bf.d}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="do-block">
          <view class="db-title">👥 团队岗位（共 {{currentProject.seats}} 席 · {{currentProject.seats - currentProject.joined}} 个空缺）</view>
          <view class="role-list">
            <view class="role-row" wx:for="{{currentProject.roles}}" wx:key="r" wx:for-item="role">
              <text class="rr-name">{{role.r}}</text>
              <text class="rr-num" style="color:{{currentProject.color}}">×{{role.n}}</text>
            </view>
          </view>
        </view>

        <view class="do-block">
          <view class="db-title">🛤 项目里程碑</view>
          <view class="ms-list">
            <view class="ms-row" wx:for="{{currentProject.milestones}}" wx:key="m" wx:for-item="ms">
              <view class="ms-dot" style="background:{{currentProject.color}}"></view>
              <text class="ms-time">{{ms.t}}</text>
              <text class="ms-text">{{ms.m}}</text>
            </view>
          </view>
        </view>

        <view class="do-block">
          <view class="db-title">💰 资金分配（共 {{currentProject.budget}} 万）</view>
          <view class="spend-list">
            <view class="spend-row" wx:for="{{currentProject.spend}}" wx:key="l" wx:for-item="sp">
              <text class="sr-label">{{sp.l}}</text>
              <view class="sr-bar-wrap">
                <view class="sr-bar-fill" style="width:{{sp.p}}%; background:{{currentProject.color}}"></view>
              </view>
              <text class="sr-pct" style="color:{{currentProject.color}}">{{sp.p}}%</text>
            </view>
          </view>
        </view>

        <view class="do-actions">
          <view class="da-apply" style="background:linear-gradient(135deg, {{currentProject.color}}, rgba(0,0,0,.4))" bindtap="onApply">
            <text>💎 申请创始席位 · {{currentProject.perSeat}}{{currentProject.seatUnit}}/席</text>
          </view>
          <view class="da-close" bindtap="closeDetail">
            <text>关闭</text>
          </view>
        </view>

        <view style="height:60rpx"></view>
      </scroll-view>
    </view>
  </view>
</view>
