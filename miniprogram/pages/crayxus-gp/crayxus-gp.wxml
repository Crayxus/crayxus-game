<!-- Crayxus AI GP · 极简驾驶大奖赛 -->
<view class="page">
  <view style="height:{{statusBarHeight}}px"></view>

  <!-- 浮动返回 -->
  <view class="float-back" style="top:{{statusBarHeight + 12}}px" bindtap="goBack">
    <text class="fb-arrow">←</text>
  </view>

  <!-- 顶部小标 -->
  <view class="top-tag">
    <text class="brand-logo-mini">🏁</text>
    <text class="brand-name">Crayxus AI GP</text>
    <view class="more-btn" bindtap="openDriverPicker">
      <text>切换 ▾</text>
    </view>
  </view>

  <!-- ==== 主舞台 ==== -->

  <!-- Avatar 大头像 -->
  <view class="avatar-stage">
    <view class="avatar-glow" style="background:radial-gradient(circle, {{selectedDriver.color}}66, transparent 70%)"></view>
    <view class="avatar-circle" style="background:linear-gradient(135deg, {{selectedDriver.color}}, rgba(0,0,0,.5)); box-shadow: 0 0 60rpx {{selectedDriver.color}}88, inset 0 -20rpx 40rpx rgba(0,0,0,.4)">
      <text class="avatar-emoji">{{selectedDriver.avatar}}</text>
    </view>
    <view class="ai-badge-big" style="background:{{selectedDriver.color}}">{{selectedDriver.aiBadge}}</view>
    <text class="driver-name">{{selectedDriver.name}}</text>
    <text class="driver-meta">{{selectedDriver.aiModel}} · {{selectedDriver.mentor}}</text>

    <view class="driver-stats-mini">
      <view class="dsm-cell">
        <text class="dsm-num" style="color:{{selectedDriver.color}}">{{selectedDriver.bestLap}}</text>
        <text class="dsm-lbl">最快圈速</text>
      </view>
      <view class="dsm-sep"></view>
      <view class="dsm-cell">
        <text class="dsm-num">{{selectedDriver.races}}</text>
        <text class="dsm-lbl">参赛</text>
      </view>
      <view class="dsm-sep"></view>
      <view class="dsm-cell">
        <text class="dsm-num" style="color:{{selectedDriver.color}}">{{selectedDriver.points}}</text>
        <text class="dsm-lbl">积分</text>
      </view>
    </view>
  </view>

  <!-- 赛道预览 -->
  <view class="track-strip" bindtap="openTrackPicker">
    <view class="ts-svg-wrap">
      <image class="ts-svg" src="{{selectedTrack.svgUri}}" mode="aspectFit"></image>
    </view>
    <view class="ts-info">
      <text class="ts-name">{{selectedTrack.name}}</text>
      <text class="ts-meta">{{selectedTrack.length}} · {{selectedTrack.turns}} 弯 · {{selectedTrack.diffStars}}</text>
    </view>
    <text class="ts-arrow">▾</text>
  </view>

  <!-- ==== 巨型 START 按钮 ==== -->
  <view class="start-zone">
    <!-- IDLE: 巨型 START -->
    <view class="start-mega" wx:if="{{raceState === 'idle'}}" bindtap="startRace"
          style="background: radial-gradient(circle, {{selectedDriver.color}} 0%, #c1121c 100%); box-shadow: 0 0 80rpx {{selectedDriver.color}}aa, 0 20rpx 60rpx rgba(0,0,0,.6)">
      <text class="sm-icon">▶</text>
      <text class="sm-label">START</text>
      <text class="sm-sub">点击开始比赛</text>
    </view>

    <!-- RACING: lap 大显示 + pause/stop -->
    <view class="racing-panel" wx:if="{{raceState === 'racing'}}">
      <view class="rp-live-tag">
        <view class="rp-dot"></view>
        <text>LIVE</text>
      </view>
      <view class="rp-lap">
        <text class="rp-lap-num">{{lap}}</text>
        <text class="rp-lap-of">/ {{totalLaps}}</text>
      </view>
      <text class="rp-lap-lbl">LAP</text>
      <view class="rp-leader" wx:if="{{liveTiming[0]}}">
        <text class="rp-leader-prefix">领跑</text>
        <text class="rp-leader-name">{{liveTiming[0].avatar}} {{liveTiming[0].name}}</text>
      </view>
      <view class="rp-actions">
        <view class="rp-btn pause" bindtap="pauseRace">
          <text>⏸ 暂停</text>
        </view>
        <view class="rp-btn stop" bindtap="stopRace">
          <text>⏹ 停止</text>
        </view>
      </view>
    </view>

    <!-- PAUSED -->
    <view class="start-mega paused" wx:if="{{raceState === 'paused'}}" bindtap="resumeRace">
      <text class="sm-icon">▶</text>
      <text class="sm-label">继续</text>
      <text class="sm-sub">已暂停 · Lap {{lap}}/{{totalLaps}}</text>
    </view>

    <!-- FINISHED -->
    <view class="finished-card" wx:if="{{raceState === 'finished'}}">
      <text class="fc-trophy">🏆</text>
      <text class="fc-champion">{{liveTiming[0].avatar}} {{liveTiming[0].name}}</text>
      <text class="fc-msg">夺冠！</text>
      <view class="fc-action" bindtap="resetRace">
        <text>🔄 再来一场</text>
      </view>
    </view>
  </view>

  <!-- 实时排位（精简 Top 3） -->
  <view class="mini-timing" wx:if="{{raceState === 'racing' && liveTiming.length > 0}}">
    <view class="mt-row" wx:for="{{liveTiming}}" wx:key="id" wx:if="{{index < 3}}"
          style="border-left-color:{{item.color}}">
      <text class="mt-pos {{index === 0 ? 'gold' : index === 1 ? 'silver' : 'bronze'}}">P{{item.pos}}</text>
      <text class="mt-avatar">{{item.avatar}}</text>
      <text class="mt-name">{{item.name}}</text>
      <text class="mt-gap" style="color:{{item.color}}">{{item.gap}}</text>
    </view>
  </view>

  <view style="height:60rpx"></view>

  <!-- ====== 车手选择 overlay ====== -->
  <view class="picker-overlay" wx:if="{{driverPickerOpen}}" catchtouchmove="_noop">
    <view class="po-mask" bindtap="closeDriverPicker"></view>
    <view class="po-sheet">
      <view class="po-handle"></view>
      <view class="po-title">选择 AI 车手</view>
      <scroll-view class="po-scroll" scroll-y="true">
        <view class="picker-driver-card {{selectedDriverId === item.id ? 'on' : ''}}"
              wx:for="{{drivers}}" wx:key="id"
              bindtap="selectDriverAndClose" data-id="{{item.id}}"
              style="border-color:{{selectedDriverId === item.id ? item.color : 'rgba(255,255,255,.08)'}}">
          <view class="pdc-avatar" style="background:linear-gradient(135deg,{{item.color}}, rgba(0,0,0,.5))">
            <text>{{item.avatar}}</text>
          </view>
          <view class="pdc-body">
            <view class="pdc-name-row">
              <text class="pdc-name">{{item.name}}</text>
              <text class="pdc-rank" style="color:{{item.color}}">#{{index + 1}}</text>
            </view>
            <text class="pdc-meta">{{item.aiModel}} · {{item.mentor}}</text>
            <text class="pdc-lap" style="color:{{item.color}}">{{item.bestLap}}  ·  {{item.points}} 分</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ====== 赛道选择 overlay ====== -->
  <view class="picker-overlay" wx:if="{{trackPickerOpen}}" catchtouchmove="_noop">
    <view class="po-mask" bindtap="closeTrackPicker"></view>
    <view class="po-sheet">
      <view class="po-handle"></view>
      <view class="po-title">选择赛道</view>
      <scroll-view class="po-scroll" scroll-y="true">
        <view class="picker-track-card {{selectedTrackId === item.id ? 'on' : ''}}"
              wx:for="{{tracks}}" wx:key="id"
              bindtap="selectTrackAndClose" data-id="{{item.id}}"
              style="border-color:{{selectedTrackId === item.id ? item.color : 'rgba(255,255,255,.08)'}}">
            <image class="ptc-svg" src="{{item.svgUri}}" mode="aspectFit"></image>
            <view class="ptc-info">
              <text class="ptc-name">{{item.name}}</text>
              <text class="ptc-meta">{{item.length}} · {{item.turns}} 弯 · {{item.diffStars}}</text>
              <text class="ptc-record" style="color:{{item.color}}">🏆 {{item.record}}</text>
            </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
